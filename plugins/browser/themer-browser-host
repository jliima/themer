#!/usr/bin/env python3
"""Native messaging host that feeds Themer's output to the browser extensions (Dark Reader and Stylus forks).

The browser starts it when an extension calls runtime.connectNative("themer") and keeps it running while the port is
open. It watches ~/.cache/themer/browser with inotify and pushes a message whenever `themer apply` rewrites a file the
extension cares about, so the extension restyles open tabs without polling.

Messages are JSON, each prefixed with its length as a native-endian uint32 (the WebExtension native messaging format).

Extension -> host
  {"type": "hello", "app": "darkreader"}         start sending this app's theme
  {"type": "hello", "app": "stylus", "styles": true, "moves": true}
                                                 also sync the styles folder (see below); "moves": the
                                                 extension understands style-moved
  {"type": "style-write", "file": F, "code": C}  write a style the user saved in the browser
  {"type": "style-delete", "file": F}            the user deleted a style in the browser
  {"type": "log", "message": M}                  written to the host log (settings the extension ignored)

Host -> extension
  {"type": "theme", "tokens": {...}, "settings": {...}}
      tokens:   ~/.cache/themer/browser/tokens.json (theme, variant, colors, fonts, shape), null before an apply
      settings: ~/.cache/themer/browser/<app>.json (rendered from the user's template) or null
  {"type": "styles-begin", "dir": D}, one {"type": "style", "file": F, "code": C, "mtime": M} per file,
  {"type": "styles-end"}                         full listing, sent after hello
  {"type": "style", ...} / {"type": "style-removed", "file": F}
                                                 a file changed or disappeared outside the browser
  {"type": "style-moved", "from": F, "file": G}  a file was moved or renamed unchanged (only with "moves")
  {"type": "error", "message": M}

The styles folder holds one UserCSS file (*.user.css) per style, so styles can be edited, versioned and shared outside
the browser. Subfolders count too: a file name F is a path relative to the folder, like "vault/site.user.css". Hidden
files and folders (".deleted", ".git", editor temp files) are skipped. The folder is [browser] stylus-styles in
settings.toml; by default the stylus/ folder next to the real settings.toml (inside the dotfiles when they are
stowed).

Python 3.11+ standard library only. Errors are logged to ~/.local/state/themer/browser-host.log; stdout is the
message channel and must carry nothing else.
"""

import ctypes
import ctypes.util
import hashlib
import json
import os
import select
import struct
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "themer"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "themer"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "themer"
BROWSER_DIR = CACHE_DIR / "browser"
STYLE_SUFFIX = ".user.css"
# Browsers refuse host messages over 1 MB.
MAX_MESSAGE = 1024 * 1024
# themer apply writes many files in a row; wait for it to settle before reading.
SETTLE = 0.15

IN_CLOSE_WRITE = 0x008
IN_MOVED_FROM = 0x040
IN_MOVED_TO = 0x080
IN_CREATE = 0x100
IN_DELETE = 0x200
IN_DELETE_SELF = 0x400
IN_MOVE_SELF = 0x800
IN_IGNORED = 0x8000
IN_NONBLOCK = 0o4000
IN_CLOEXEC = 0o2000000
WATCH_MASK = IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF


def log(msg):
  try:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_DIR / "browser-host.log", "a") as f:
      f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} [{os.getpid()}] {msg}\n")
  except OSError:
    pass


# ---------------------------------------------------------------------------------------------------------------------
# Native messaging
# ---------------------------------------------------------------------------------------------------------------------

def send(msg):
  data = json.dumps(msg, ensure_ascii=False).encode()
  if len(data) > MAX_MESSAGE:
    log(f"message {msg.get('type')} ({msg.get('file', '')}) is {len(data)} bytes, over the browser limit; not sent")
    data = json.dumps({"type": "error", "message": f"{msg.get('file') or msg.get('type')} is too large"}).encode()
  sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
  sys.stdout.buffer.flush()


def read_exact(fd, n):
  buf = b""
  while len(buf) < n:
    chunk = os.read(fd, n - len(buf))
    if not chunk:
      return None
    buf += chunk
  return buf


def receive(fd):
  """One message from the browser, or None when it closed the port."""
  head = read_exact(fd, 4)
  if head is None:
    return None
  body = read_exact(fd, struct.unpack("=I", head)[0])
  return None if body is None else json.loads(body)


# ---------------------------------------------------------------------------------------------------------------------
# inotify
# ---------------------------------------------------------------------------------------------------------------------

class Inotify:
  def __init__(self):
    self.libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    self.fd = self.libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
    if self.fd < 0:
      raise OSError(ctypes.get_errno(), "inotify_init1")
    self.paths = {}

  def watch(self, path):
    """Watch a folder; returns False when it does not exist (yet)."""
    if path in self.paths.values() or not path.is_dir():
      return path in self.paths.values()
    wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), WATCH_MASK)
    if wd < 0:
      log(f"cannot watch {path}: {os.strerror(ctypes.get_errno())}")
      return False
    self.paths[wd] = path
    return True

  def unwatch(self, path):
    for wd, p in list(self.paths.items()):
      if p == path:
        self.libc.inotify_rm_watch(self.fd, wd)
        del self.paths[wd]

  def read(self):
    """(folder, name, mask) for every pending event."""
    events = []
    try:
      data = os.read(self.fd, 65536)
    except BlockingIOError:
      return events
    i = 0
    while i < len(data):
      wd, mask, _cookie, size = struct.unpack_from("iIII", data, i)
      name = data[i + 16:i + 16 + size].rstrip(b"\0").decode(errors="replace")
      i += 16 + size
      folder = self.paths.get(wd)
      if mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED):
        self.paths.pop(wd, None)
      if folder is not None:
        events.append((folder, name, mask))
    return events


# ---------------------------------------------------------------------------------------------------------------------
# Theme and styles
# ---------------------------------------------------------------------------------------------------------------------

def read_json(path):
  try:
    return json.loads(path.read_text())
  except FileNotFoundError:
    return None
  except (OSError, ValueError) as e:
    log(f"cannot read {path}: {e}")
    send({"type": "error", "message": f"{path}: {e}"})
    return None


def settings_toml():
  env = os.environ.get("THEMER_SETTINGS")
  path = Path(env) if env else CONFIG_DIR / "settings.toml"
  try:
    with open(path, "rb") as f:
      return path, tomllib.load(f)
  except (OSError, tomllib.TOMLDecodeError):
    return path, {}


def styles_dir():
  path, settings = settings_toml()
  custom = settings.get("browser", {}).get("stylus-styles")
  if custom:
    return Path(os.path.expanduser(custom))
  # Next to the real settings.toml, so with stowed dotfiles the styles are in the repo, not in a folder of links.
  return path.resolve().parent / "stylus"


def style_path(folder, name):
  """The file for a style name from the extension, or None when the name is not a *.user.css path inside the folder
  (relative, "/" separated, no hidden or empty parts)."""
  if not isinstance(name, str) or not name.endswith(STYLE_SUFFIX) or "\\" in name or "\0" in name:
    return None
  parts = name.split("/")
  if any(not part or part.startswith(".") for part in parts):
    return None
  return folder.joinpath(*parts)


def style_tree(folder):
  """(folders, {name: path}) of the styles folder and its subfolders, hidden ones left out."""
  folders, files = [], {}
  for top, dirs, names in os.walk(folder):
    dirs[:] = sorted(d for d in dirs if not d.startswith("."))
    folders.append(Path(top))
    for name in names:
      if name.endswith(STYLE_SUFFIX) and not name.startswith("."):
        path = Path(top, name)
        files[path.relative_to(folder).as_posix()] = path
  return folders, files


def digest(data):
  return hashlib.sha1(data.encode() if isinstance(data, str) else data).hexdigest()


class Host:
  def __init__(self):
    self.app = None
    self.styles = None
    self.moves = False
    self.inotify = Inotify()
    self.sent_theme = None
    # file name -> digest of the content the browser has, so our own writes and unchanged files are not echoed back
    self.known = {}
    self.pending = set()
    self.deadline = None

  def watch_all(self):
    self.inotify.watch(CACHE_DIR)
    self.inotify.watch(BROWSER_DIR)
    if self.styles:
      folders = set(style_tree(self.styles)[0]) if self.styles.is_dir() else set()
      for path in list(self.inotify.paths.values()):
        if path not in folders and self.in_styles(path):
          self.inotify.unwatch(path)
      for path in sorted(folders):
        self.inotify.watch(path)

  def in_styles(self, path):
    return self.styles is not None and (path == self.styles or self.styles in path.parents)

  def theme(self, force=False):
    msg = {"type": "theme", "tokens": read_json(BROWSER_DIR / "tokens.json"),
           "settings": read_json(BROWSER_DIR / f"{self.app}.json")}
    key = digest(json.dumps(msg, sort_keys=True))
    if force or key != self.sent_theme:
      self.sent_theme = key
      send(msg)

  def read_styles(self):
    """{name: (code, mtime)} of every style file that can be read."""
    styles = {}
    for name, path in style_tree(self.styles)[1].items():
      try:
        styles[name] = path.read_text(), int(path.stat().st_mtime * 1000)
      except FileNotFoundError:
        pass
      except (OSError, UnicodeDecodeError) as e:
        send({"type": "error", "message": f"{path}: {e}"})
        if name in self.known:
          styles[name] = None  # unreadable for now, not gone
    return styles

  def sync_styles(self):
    """Tells the extension what changed in the folder since it last heard."""
    styles = self.read_styles()
    changed = {name: (code, mtime, digest(code)) for name, entry in styles.items() if entry is not None
               for code, mtime in [entry] if self.known.get(name) != digest(code)}
    removed = [name for name in self.known if name not in styles]
    if self.moves:
      # A file moved or renamed as it is: the extension relinks its style instead of deleting and reinstalling it,
      # which would lose the style's state (enabled, options, position).
      for old in list(removed):
        new = next((name for name, entry in changed.items() if name not in self.known and entry[2] == self.known[old]),
                   None)
        if new:
          removed.remove(old)
          del changed[new]
          self.known[new] = self.known.pop(old)
          send({"type": "style-moved", "from": old, "file": new})
    for name in removed:
      del self.known[name]
      send({"type": "style-removed", "file": name})
    for name, (code, mtime, key) in sorted(changed.items()):
      self.known[name] = key
      send({"type": "style", "file": name, "code": code, "mtime": mtime})

  def list_styles(self):
    self.styles.mkdir(parents=True, exist_ok=True)
    self.known = {}
    send({"type": "styles-begin", "dir": str(self.styles)})
    self.sync_styles()
    send({"type": "styles-end"})

  def write_style(self, name, code):
    path = style_path(self.styles, name)
    if path is None or not isinstance(code, str):
      send({"type": "error", "message": f"refused to write style file {name!r}"})
      return
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(code)
    os.replace(tmp, path)
    self.known[name] = digest(code)

  def delete_style(self, name):
    path = style_path(self.styles, name)
    if path is None:
      send({"type": "error", "message": f"refused to delete style file {name!r}"})
      return
    # Kept as a hidden backup rather than removed: a style deleted by mistake in the browser is easy to get back.
    trash = self.styles / ".deleted" / name
    if path.exists():
      trash.parent.mkdir(parents=True, exist_ok=True)
      os.replace(path, trash)
    self.known.pop(name, None)

  def on_message(self, msg):
    kind = msg.get("type")
    if kind == "hello":
      self.app = str(msg.get("app", ""))
      if not self.app.isidentifier():
        send({"type": "error", "message": f"bad app name {self.app!r}"})
        return
      if msg.get("styles"):
        self.styles = styles_dir()
        self.moves = bool(msg.get("moves"))
        self.list_styles()
      self.watch_all()
      self.theme(force=True)
    elif kind == "log":
      log(f"{self.app}: {msg.get('message')}")
    elif kind == "style-write" and self.styles:
      self.write_style(msg.get("file"), msg.get("code"))
    elif kind == "style-delete" and self.styles:
      self.delete_style(msg.get("file"))
    else:
      send({"type": "error", "message": f"unexpected message {kind!r}"})

  def on_events(self, events):
    for folder, name, _mask in events:
      if self.in_styles(folder):
        # A style file, or a subfolder created, moved or deleted: compare the whole tree in flush().
        if not name.startswith(".") or not name:
          self.pending.add(("styles", None))
      elif folder == CACHE_DIR and name == "browser":
        self.pending.add(("theme", None))
      elif folder == BROWSER_DIR and name in ("tokens.json", f"{self.app}.json"):
        self.pending.add(("theme", None))
    if self.pending:
      self.deadline = time.monotonic() + SETTLE

  def flush(self):
    pending, self.pending, self.deadline = self.pending, set(), None
    # Folders created after the start (first apply, first style) are only watchable now.
    self.watch_all()
    for kind, _name in sorted(pending, key=lambda p: p[0]):
      if kind == "theme":
        self.theme()
      elif self.styles:
        self.sync_styles()

  def run(self):
    stdin = sys.stdin.fileno()
    while True:
      timeout = None if self.deadline is None else max(0.0, self.deadline - time.monotonic())
      # Folders that did not exist at hello are retried every few seconds until they do.
      if timeout is None and self.app and len(self.inotify.paths) < (3 if self.styles else 2):
        timeout = 5.0
      ready, _, _ = select.select([stdin, self.inotify.fd], [], [], timeout)
      if stdin in ready:
        msg = receive(stdin)
        if msg is None:
          return
        try:
          self.on_message(msg)
        except Exception as e:  # noqa: BLE001 - keep the port alive, report to the extension
          log(f"handling {msg.get('type')}: {e!r}")
          send({"type": "error", "message": str(e)})
      if self.inotify.fd in ready:
        self.on_events(self.inotify.read())
      if self.deadline is not None and time.monotonic() >= self.deadline:
        self.flush()
      elif not ready and self.app:
        self.watch_all()


def main():
  try:
    Host().run()
  except BrokenPipeError:
    pass
  except Exception as e:  # noqa: BLE001
    log(f"fatal: {e!r}")
    raise


if __name__ == "__main__":
  main()
