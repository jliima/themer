def cmd_apply(args):
  pal, variant = pick(args)
  tid = pal["meta"]["id"]
  problems = validate(pal)
  if problems and not args.force:
    die(f"theme {tid} does not fill the token contract:\n  " + "\n  ".join(problems) + "\n(--force to apply anyway)")
  only = set(args.only.split(",")) if args.only else None
  w = Writer(dry_run=args.dry_run)
  state = read_state()
  switched = state.get("theme") != tid or state.get("variant") != variant
  ctxs = {v: context(pal, v) for v in variants_of(pal)}
  reloads, skipped, stowed = [], [], []
  df = dotfiles_dir()
  for t in load_targets():
    if only and t.get("group", "misc") not in only and t.get("name") not in only:
      continue
    if t.get("enabled", True) is False:
      continue
    vs = variants_of(pal) if t.get("variants", "active") == "all" else (variant,)
    for v in vs:
      ctx = ctxs[v]
      out = expand_path(t["output"], ctx, pal)
      if out is None:
        skipped.append(f"{t['name']} (no Firefox profile found)")
        break
      shown = out
      if df and t.get("dotfiles") and home_rel(out) is not None:
        stowed.append((out, df / home_rel(out)))
        out = df / home_rel(out)
        shown = f"{out} (stowed to {stowed[-1][0]})"
      if t.get("adopt"):
        adopt(out, user_dir() / t["adopt"], args.dry_run)
      if "format" in t:
        text = FORMATS[t["format"]](pal, v)
      else:
        text = render(template_path(t["template"], pal).read_text(), ctx, t["template"])
      mode = t.get("mode", "write")
      if mode == "merge-ini":
        changed = w.merge_ini(out, text)
      elif mode == "ensure-lines":
        changed = w.ensure_lines(out, text)
      else:
        changed = w.write(out, text)
      if changed:
        print(f"{'would write' if args.dry_run else 'wrote'} {shown}")
      if t.get("reload") and (changed or args.force or switched) and v == variant:
        reloads.append(t["reload"])
  linked = True
  if stowed:
    for home_path, df_path in stowed:
      clear_for_stow(w, home_path, df_path)
    missing = [h for h, d in stowed if os.path.realpath(h) != os.path.realpath(d)]
    in_df = any(os.path.realpath(p).startswith(os.path.realpath(df) + os.sep) for p in w.changed)
    if missing or in_df or args.force:
      linked = stow(dry_run=args.dry_run)
      if not args.dry_run:
        linked = link_missing(stowed) and linked
  if not args.dry_run:
    write_state(tid, variant)
    for action in dict.fromkeys(reloads):
      run_reload(action, ctxs[variant])
    prune_backups()
  for s in skipped:
    print(f"skipped {s}")
  label = f"{pal['meta']['name']} {variant}"
  if not w.changed:
    print(f"{label}: everything already up to date")
  elif not args.dry_run:
    print(f"\n{label}: {len(w.changed)} files updated. Backups: {w.backup_root}")
    notes = []
    if any("mozilla" in str(p) for p in w.changed):
      notes.append("restart Firefox")
    if any(p.name in ("darklyrc", "kdeglobals") for p in w.changed):
      notes.append("restart open Qt apps to pick up style and font changes")
    if any(p.suffix == ".theme" for p in w.changed):
      notes.append("reopen Kate/KWrite")
    if notes:
      print("Next: " + "; ".join(notes) + ".")
  if not linked:
    sys.exit(1)


def cmd_mode(args):
  state = read_state()
  if not state.get("theme"):
    die("nothing applied yet; run themer apply --theme <name> first")
  pal = load_theme(state["theme"])
  cur = state.get("variant", pal["meta"]["default-variant"])
  vs = variants_of(pal)
  if args.mode == "toggle":
    if len(vs) < 2:
      die(f"theme {state['theme']} only has a {vs[0]} variant")
    new = vs[(vs.index(cur) + 1) % len(vs)] if cur in vs else vs[0]
  else:
    new = args.mode
  args.theme, args.variant = state["theme"], new
  cmd_apply(args)


