def firefox_profile(pal):
  """The default Firefox profile: $THEMER_FIREFOX_PROFILE, [firefox] profile in settings.toml, or detected."""
  forced = os.environ.get("THEMER_FIREFOX_PROFILE") or settings().get("firefox", {}).get("profile")
  if forced:
    p = Path(os.path.expanduser(forced))
    return p if p.is_dir() else None
  roots = [HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox", HOME / "snap/firefox/common/.mozilla/firefox",
           HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox",
           HOME / ".var/app/org.mozilla.firefox/config/mozilla/firefox"]
  for root in roots:
    ini = root / "profiles.ini"
    if not ini.exists():
      continue
    _, groups, _ = parse_ini(ini.read_text())

    def kv(g):
      return dict(ln.split("=", 1) for ln in groups.get(g, []) if "=" in ln)
    for g in groups:
      if g.startswith("[Install"):
        d = kv(g).get("Default")
        if d:
          p = Path(d) if d.startswith("/") else root / d
          if p.is_dir():
            return p
    for g in groups:
      v = kv(g)
      if g.startswith("[Profile") and v.get("Default") == "1":
        p = root / v["Path"] if v.get("IsRelative", "1") == "1" else Path(v["Path"])
        if p.is_dir():
          return p
  return None


def load_targets():
  """The shipped targets, then ~/.config/themer/targets.toml on top: a user target with the name of a shipped one
  replaces it (enabled = false turns it off), any other name is added at the end."""
  targets = {t["name"]: t for t in load_toml(SELF_DIR / "targets.toml").get("target", [])}
  for d in user_dirs():
    if (d / "targets.toml").exists():
      for t in load_toml(d / "targets.toml").get("target", []):
        targets[t["name"]] = t
      break
  return list(targets.values())


def template_path(name, pal):
  """User templates override the theme's own, which override the shipped ones."""
  for d in (*[u / "templates" for u in user_dirs()], pal["_dir"] / "templates", SELF_DIR / "templates"):
    if (d / name).exists():
      return d / name
  die(f"template {name} not found")


def expand_path(p, ctx, pal):
  p = render(p, ctx, "output path")
  if "{firefox}" in p:
    prof = firefox_profile(pal)
    if not prof:
      return None
    p = p.replace("{firefox}", str(prof))
  return Path(os.path.expanduser(p))


def run_reload(action, ctx, quiet=False):
  def have(cmd):
    return shutil.which(cmd) is not None

  def sh(*cmd):
    if not quiet:
      print("  $ " + " ".join(cmd))
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

  if action == "kde-colors":
    scheme = ctx["scheme"]
    kdeglobals = HOME / ".config/kdeglobals"
    current = None
    if kdeglobals.exists():
      _, g, _ = parse_ini(kdeglobals.read_text())
      current = next((ln.split("=", 1)[1] for ln in g.get("[General]", []) if ln.startswith("ColorScheme=")), None)
    if current != scheme and have("plasma-apply-colorscheme"):
      sh("plasma-apply-colorscheme", scheme)
    else:
      src = HOME / f".local/share/color-schemes/{scheme}.colors"
      if src.exists():
        _, g, order = parse_ini(src.read_text())
        keep = [k for k in order if k.startswith(("[Colors:", "[ColorEffects:", "[WM]"))]
        frag = "\n".join(k + "\n" + "\n".join(g[k]) for k in keep) + f"\n[General]\nColorScheme={scheme}\n"
        Writer().merge_ini(kdeglobals, frag)
        if have("dbus-send"):
          sh("dbus-send", "--session", "--type=signal", "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
             "int32:0", "int32:0")
  elif action == "kwin":
    if have("dbus-send"):
      sh("dbus-send", "--session", "--type=method_call", "--dest=org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure")
  elif action == "kde-style":
    if have("dbus-send"):
      sh("dbus-send", "--session", "--type=signal", "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
         "int32:2", "int32:0")
  elif action == "gtk":
    if have("gsettings"):
      sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
         "prefer-dark" if ctx["variant"] == "dark" else "default")
  elif action:
    if not quiet:
      print(f"  $ {action}")
    subprocess.run(action, shell=True)


# ---------------------------------------------------------------------------------------------------------------------
# State: which theme and variant are applied
# ---------------------------------------------------------------------------------------------------------------------

def read_state():
  f = STATE_DIR / "current.json"
  if f.exists():
    try:
      return json.loads(f.read_text())
    except json.JSONDecodeError:
      pass
  return {}


def write_state(theme, variant):
  STATE_DIR.mkdir(parents=True, exist_ok=True)
  (STATE_DIR / "current.json").write_text(json.dumps({"theme": theme, "variant": variant}) + "\n")


def pick(args, need_variant=True):
  """Works out the theme and variant from --theme (pare or pare:light), --variant, the current state, settings."""
  state = read_state()
  ref = getattr(args, "theme", None) or state.get("theme") or settings().get("default-theme") or "pare"
  variant = getattr(args, "variant", None)
  if ":" in ref and not Path(ref).exists():
    ref, variant = ref.split(":", 1)
  pal = load_theme(ref)
  if not variant and state.get("theme") == pal["meta"]["id"]:
    variant = state.get("variant")
  if not variant or variant not in variants_of(pal):
    variant = pal["meta"]["default-variant"]
  return pal, variant


def prune_backups(keep=15):
  root = STATE_DIR / "backups"
  if root.exists():
    runs = sorted(p for p in root.iterdir() if p.is_dir())
    for p in runs[:-keep]:
      shutil.rmtree(p, ignore_errors=True)


# ---------------------------------------------------------------------------------------------------------------------
# Dotfiles: generated files that belong in the dotfiles repo are written there and linked with stow
# ---------------------------------------------------------------------------------------------------------------------

DEFAULT_STOW = "stow --no-folding --dir={dotfiles} --target={home} ."


def stow(dry_run=False):
  """Runs the configured stow command. Returns True when it succeeded or nothing needed doing."""
  df = dotfiles_dir()
  if not df:
    return True
  cmd = settings().get("dotfiles", {}).get("stow", DEFAULT_STOW)
  if not cmd:
    return True
  cmd = cmd.replace("{dotfiles}", shlex.quote(str(df))).replace("{home}", shlex.quote(str(HOME)))
  if dry_run:
    print(f"would run: {cmd}")
    return True
  if not shutil.which("stow") and cmd.startswith("stow"):
    print("stow is not installed (sudo apt install stow); files were written to the dotfiles folder but not linked")
    return False
  print(f"  $ {cmd}")
  res = subprocess.run(cmd, shell=True, cwd=df, capture_output=True, text=True)
  if res.returncode != 0:
    print(res.stderr.strip() or res.stdout.strip())
    print("stow failed: files are in the dotfiles folder but some links were not made. Fix the conflicts above and "
          "run `themer apply` again.")
    return False
  return True


def adopt(out, dest, dry_run):
  """Keeps a hand-written file Themer is about to replace (an old userChrome.css) as a disabled snippet."""
  if not out.is_file() or "Generated by Themer" in out.read_text(errors="replace") or dest.exists():
    return
  if dry_run:
    print(f"would keep your {out.name} as {dest}")
    return
  dest.parent.mkdir(parents=True, exist_ok=True)
  shutil.copy2(out, dest)
  print(f"kept your {out.name} as {dest} (disabled; drop the leading _ to load it on top of the theme)")


def link_missing(pairs):
  """After stow: links any of Themer's own files stow did not, the same relative way stow would, so the desktop
  is themed even when stow stopped on an unrelated conflict. Returns True if everything is linked."""
  ok = True
  for home_path, df_path in pairs:
    if os.path.realpath(home_path) == os.path.realpath(df_path):
      continue
    if home_path.exists() or home_path.is_symlink():
      print(f"not linked: {home_path} exists and is not a Themer file")
      ok = False
      continue
    home_path.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(os.path.relpath(df_path, os.path.realpath(home_path.parent)), home_path)
    print(f"linked {home_path} -> {df_path} (stow did not)")
  return ok


def clear_for_stow(w, home_path, df_path):
  """Makes room for stow's link at home_path. Only used on files Themer generates; the old file is backed up."""
  if not (home_path.exists() or home_path.is_symlink()):
    return
  if os.path.realpath(home_path) == os.path.realpath(df_path):
    return
  if w.dry_run:
    print(f"would replace {home_path} with a link to {df_path}")
    return
  if home_path.is_symlink():
    home_path.unlink()
  elif home_path.is_file():
    w._backup(home_path)
    home_path.unlink()


