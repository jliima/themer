def main():
  ap = argparse.ArgumentParser(prog="themer", description="Install a design system into every app on the desktop.")
  ap.add_argument("--version", action="version", version=f"themer {VERSION}")
  sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")

  def theme_opts(p, variant=True):
    p.add_argument("-t", "--theme", help="theme id, folder or theme.toml; id:variant also works (default: current)")
    if variant:
      p.add_argument("-v", "--variant", choices=VARIANTS, help="default: current, else the theme's default")

  p = sub.add_parser("apply", help="render every target for a theme and reload")
  theme_opts(p)
  p.add_argument("--only", help="comma separated groups or target names (kde, konsole, kate, gtk, firefox, exports)")
  p.add_argument("--dry-run", action="store_true", help="list what would change, write nothing")
  p.add_argument("--force", action="store_true", help="reload even if nothing changed; apply despite contract gaps")
  p.set_defaults(fn=cmd_apply)

  p = sub.add_parser("mode", help="switch the current theme's variant: dark, light or toggle")
  p.add_argument("mode", choices=("dark", "light", "toggle"))
  p.add_argument("--only")
  p.add_argument("--dry-run", action="store_true")
  p.add_argument("--force", action="store_true")
  p.set_defaults(fn=cmd_mode)

  p = sub.add_parser("themes", help="list installed themes")
  p.set_defaults(fn=cmd_themes)
  p = sub.add_parser("current", help="print the applied theme and variant")
  p.set_defaults(fn=cmd_current)

  p = sub.add_parser("new", help="start a theme from an existing one: themer new mytheme --from ID")
  p.add_argument("id")
  p.add_argument("--from", dest="base", required=True, help="theme id, folder or theme.toml to start from")
  p.add_argument("--name")
  p.set_defaults(fn=cmd_new)

  p = sub.add_parser("install", help="install a theme from a folder, theme.toml or .zip")
  p.add_argument("source")
  p.add_argument("--id")
  p.add_argument("--replace", action="store_true")
  p.set_defaults(fn=cmd_install)

  p = sub.add_parser("remove", help="remove a user-installed theme")
  p.add_argument("id")
  p.set_defaults(fn=cmd_remove)

  p = sub.add_parser("edit", help="open a theme's theme.toml (copies a theme given by path to your config first)")
  p.add_argument("theme", nargs="?")
  p.add_argument("--print", action="store_true", help="only print the path")
  p.set_defaults(fn=cmd_edit)

  p = sub.add_parser("import", help="make a theme from a design system tokens.json")
  p.add_argument("tokens")
  p.add_argument("--id", required=True)
  p.add_argument("--name")
  p.add_argument("--description")
  p.add_argument("-o", "--output", help="theme.toml path, or - for stdout (default: ~/.config/themer/themes/<id>)")
  p.add_argument("--replace", action="store_true")
  p.set_defaults(fn=cmd_import)

  p = sub.add_parser("validate", help="check a theme fills the token contract")
  theme_opts(p, variant=False)
  p.set_defaults(fn=cmd_validate)

  p = sub.add_parser("check", help="contrast report for every variant of a theme")
  theme_opts(p, variant=False)
  p.set_defaults(fn=cmd_check)

  for name, fn, h in (("show", cmd_show, "swatches in the terminal"), ("tokens", cmd_tokens, "every resolved token")):
    p = sub.add_parser(name, help=h)
    theme_opts(p)
    p.set_defaults(fn=fn)

  p = sub.add_parser("get", help="print one value, with filters: themer get 'accent | rgb'")
  p.add_argument("token")
  theme_opts(p)
  p.set_defaults(fn=cmd_get)

  p = sub.add_parser("set", help="change a value: themer set blue 'oklch(0.75 0.13 246)' [--theme ID --variant dark]")
  p.add_argument("token")
  p.add_argument("value")
  theme_opts(p)
  p.add_argument("--section", help="table to edit instead of the variant, for example roles")
  p.set_defaults(fn=cmd_set)

  p = sub.add_parser("undo", help="restore the files changed by the last apply")
  p.add_argument("--dry-run", action="store_true")
  p.set_defaults(fn=cmd_undo)

  p = sub.add_parser("stow", help="link the dotfiles folder into ~ with the configured stow command")
  p.add_argument("--dry-run", action="store_true")
  p.set_defaults(fn=cmd_stow)

  p = sub.add_parser("screens", help="outputs and their scale; sets the ones listed under [screens] in settings.toml")
  p.add_argument("--apply", action="store_true",
                 help="run the kscreen-doctor commands instead of printing them, switch to the matching profile")
  p.add_argument("--watch", action="store_true", help="--apply now and after every display hotplug, until stopped")
  p.set_defaults(fn=cmd_screens)

  p = sub.add_parser("profile", help="list the screen profiles, or switch: themer profile NAME|auto|none")
  p.add_argument("name", nargs="?")
  p.set_defaults(fn=cmd_profile)

  p = sub.add_parser("doctor", help="check what Themer needs")
  theme_opts(p, variant=False)
  p.set_defaults(fn=cmd_doctor)

  args = ap.parse_args()
  args.fn(args)


if __name__ == "__main__":
  main()
