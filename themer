def cmd_stow(args):
  if not dotfiles_dir():
    die("dotfiles are off ([dotfiles] enabled = false in settings.toml)")
  sys.exit(0 if stow(dry_run=args.dry_run) else 1)


def screen_outputs():
  """The outputs as kscreen-doctor -j reports them."""
  if not shutil.which("kscreen-doctor"):
    die("kscreen-doctor not found; set scales in System Settings > Display Configuration")
  res = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True)
  try:
    return json.loads(res.stdout)["outputs"]
  except (json.JSONDecodeError, KeyError):
    die("could not read the outputs from kscreen-doctor -j")


def diagonal(o):
  """An output's diagonal in inches, from its physical size; None when the screen does not report one."""
  mm = o.get("sizeMM") or {}
  w, h = mm.get("width", 0), mm.get("height", 0)
  return math.hypot(w, h) / 25.4 if w and h else None


def profiles():
  return [p for p in settings().get("profile", []) if isinstance(p, dict) and p.get("name")]


def find_profile(name):
  return next((p for p in profiles() if p["name"] == name), None) if name else None


def profile_matches(prof, o):
  """True when the output is on and fits the profile's `outputs` (connector name globs) and `inches` ([min, max]
  diagonal). A profile with neither is only ever chosen by hand."""
  if not (o.get("connected", True) and o.get("enabled", True)) or not ("outputs" in prof or "inches" in prof):
    return False
  if "outputs" in prof and not any(fnmatch.fnmatchcase(o["name"], p) for p in prof["outputs"]):
    return False
  if "inches" in prof:
    d = diagonal(o)
    if d is None or not prof["inches"][0] <= d <= prof["inches"][1]:
      return False
  return True


def profile_for(outputs):
  """The first profile in settings.toml that one of the enabled outputs matches, else None."""
  return next((p["name"] for p in profiles() if any(profile_matches(p, o) for o in outputs)), None)


def set_profile(name):
  """Makes `name` (None: no profile) the active profile and re-applies the current theme if that changed it."""
  state = read_state()
  if state.get("profile") == name:
    return False
  print(f"profile {state.get('profile') or 'none'} -> {name or 'none'}")
  write_state(profile=name)
  if state.get("theme"):
    cmd_apply(argparse.Namespace(theme=None, variant=None, only=None, dry_run=False, force=False))
  return True


def screens_step(apply):
  """Prints the outputs; with apply, sets the scales from [screens] and switches to the matching profile."""
  outputs = screen_outputs()
  wanted = settings().get("screens", {})
  todo = []
  for o in outputs:
    w, h, cur = o["size"]["width"], o["size"]["height"], float(o.get("scale", 1))
    d = diagonal(o)
    size = f'  {d:.0f}"' if d else ""
    state = "" if o.get("enabled", True) else "  (disabled)"
    print(f"{o['name']:<10} {w}x{h}{size}  scale {cur:g}  logical {round(w / cur)}x{round(h / cur)}{state}")
    want = wanted.get(o["name"])
    if want is not None and abs(float(want) - cur) > 1e-6 and o.get("enabled", True):
      todo.append((o["name"], float(want)))
  for name, scale in todo:
    cmd = ["kscreen-doctor", f"output.{name}.scale.{scale:g}"]
    if apply:
      print(f"$ {' '.join(cmd)}")
      subprocess.run(cmd, stderr=subprocess.DEVNULL)
    else:
      print(f"\n  {' '.join(cmd)}")
  match = profile_for(outputs)
  if profiles():
    print(f"profile    {match or 'none'} (active: {read_state().get('profile') or 'none'})")
  if apply:
    set_profile(match)
  return todo, match


def cmd_screens(args):
  """Lists the outputs with their scale and logical size. `[screens]` in settings.toml maps an output name to the
  scale you want (DP-1 = 1.5); the kscreen-doctor commands for the ones that differ are printed, or run with --apply.
  `[[profile]]` tables pick overrides by the screens that are on; --apply switches to the matching one, --watch does
  that again after every display hotplug."""
  if args.watch:
    watch_screens()
    return
  todo, match = screens_step(args.apply)
  if not settings().get("screens") and not profiles():
    print("\nSet the scale you want per output in settings.toml, then run this again:\n\n  [screens]\n  DP-1 = 1.5")
  if (todo or match != read_state().get("profile")) and not args.apply:
    print("\n--apply runs these and switches the profile.")


def watch_screens():
  """Runs the screens step now and again after display hotplugs (udev drm events), until stopped. Each burst of events
  is handled twice, 2 s after the last event and again 8 s later, since KWin turns new outputs on with a delay."""
  global _SETTINGS
  if not shutil.which("udevadm"):
    die("udevadm not found")
  mon = subprocess.Popen(["udevadm", "monitor", "--udev", "--subsystem-match=drm"], stdout=subprocess.PIPE)
  fd = mon.stdout.fileno()
  due = [0.0]
  while True:
    timeout = max(0.0, min(due) - time.monotonic()) if due else None
    ready, _, _ = select.select([fd], [], [], timeout)
    if ready:
      if not os.read(fd, 65536):
        die("udevadm monitor stopped")
      now = time.monotonic()
      due = [now + 2, now + 10]
      continue
    due.pop(0)
    _SETTINGS = None
    try:
      screens_step(apply=True)
    except SystemExit as e:
      print(e, file=sys.stderr)
    sys.stdout.flush()


def cmd_profile(args):
  """Shows the screen profiles, or switches to one by hand: a name, `auto` (the one the screens match) or `none`."""
  if args.name is None:
    active = read_state().get("profile")
    for p in profiles():
      when = ", ".join(filter(None, (" ".join(p.get("outputs", [])),
                                     "{}-{} inches".format(*p["inches"]) if "inches" in p else "")))
      print(f"{'*' if p['name'] == active else ' '} {p['name']:<14} {when or 'by hand only'}")
    if not profiles():
      print("no [[profile]] tables in settings.toml")
    return
  if args.name == "auto":
    screens_step(apply=True)
    return
  name = None if args.name == "none" else args.name
  if name and not find_profile(name):
    die(f"no profile {name} in settings.toml; there are: {', '.join(p['name'] for p in profiles()) or 'none'}")
  if not set_profile(name):
    print(f"profile {name or 'none'} is already active")


def cmd_doctor(args):
  state = read_state()
  print(f"themer    {SELF_DIR}")
  print(f"config    {CONFIG_DIR}" + (f" -> {os.path.realpath(CONFIG_DIR)}" if CONFIG_DIR.is_symlink() else ""))
  df = dotfiles_dir()
  if df:
    print(f"dotfiles  {df} (user files in {user_dir()})")
    print(f"          stow: {settings().get('dotfiles', {}).get('stow', DEFAULT_STOW)}")
  else:
    print("dotfiles  off ([dotfiles] in settings.toml)")
  extra = next((d / "targets.toml" for d in user_dirs() if (d / "targets.toml").exists()), None)
  print(f"targets   {SELF_DIR / 'targets.toml'}" + (f" + {extra}" if extra else ""))
  print(f"themes    {', '.join(sorted(all_themes())) or 'none'}")
  print(f"applied   {state.get('theme', 'nothing yet')} {state.get('variant', '')}")
  pal, _ = pick(args)
  prof = firefox_profile(pal)
  print(f"firefox   {prof or 'no profile found (set [firefox] profile in ~/.config/themer/settings.toml)'}")
  for cmd in ("plasma-apply-colorscheme", "dbus-send", "gsettings", "konsole", "kscreen-doctor"):
    print(f"{cmd:<26}{'ok' if shutil.which(cmd) else 'missing'}")
  styles = [Path(p) for p in ("/usr/lib/x86_64-linux-gnu/qt6/plugins/styles", "/usr/lib/qt6/plugins/styles",
                              "/usr/lib64/qt6/plugins/styles")]
  darkly = any(p.exists() and any("darkly" in f.name.lower() for f in p.iterdir()) for p in styles)
  print(f"{'Darkly widget style':<26}{'ok' if darkly else 'not found (the KDE targets expect Darkly)'}")
  fonts = ""
  if shutil.which("fc-list"):
    fonts = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout
  for fam in dict.fromkeys((pal["fonts"]["sans"], pal["fonts"]["mono"])):
    print(f"{fam:<26}{'ok' if fam in fonts else 'not installed'}")


