def read_state():
  f = STATE_DIR / "current.json"
  if f.exists():
    try:
      return json.loads(f.read_text())
    except json.JSONDecodeError:
      pass
  return {}


def write_state(**values):
  """Updates the given keys of the state (theme, variant, profile), keeping the others. None removes a key."""
  state = read_state()
  state.update(values)
  state = {k: v for k, v in state.items() if v is not None}
  STATE_DIR.mkdir(parents=True, exist_ok=True)
  (STATE_DIR / "current.json").write_text(json.dumps(state) + "\n")


def pick(args, need_variant=True):
  """Works out the theme and variant from --theme (ID or ID:light), --variant, the current state, settings."""
  state = read_state()
  ref = getattr(args, "theme", None) or state.get("theme") or settings().get("default-theme")
  if not ref:
    die("no theme to use: pass --theme ID, or set default-theme in settings.toml. "
        f"Installed themes: {', '.join(sorted(all_themes())) or 'none (themer install PATH adds one)'}")
  variant = getattr(args, "variant", None)
  if ":" in ref and not Path(ref).exists():
    ref, variant = ref.split(":", 1)
  pal = load_theme(ref)
  if not variant and state.get("theme") == pal["meta"]["id"]:
    variant = state.get("variant")
  if not variant or variant not in variants_of(pal):
    variant = pal["meta"]["default-variant"]
  return pal, variant


def prune_backups(keep=15):
  root = STATE_DIR / "backups"
  if root.exists():
    runs = sorted(p for p in root.iterdir() if p.is_dir())
    for p in runs[:-keep]:
      shutil.rmtree(p, ignore_errors=True)


# ---------------------------------------------------------------------------------------------------------------------
# Dotfiles: generated files that belong in the dotfiles repo are written there and linked with stow
# ---------------------------------------------------------------------------------------------------------------------

DEFAULT_STOW = "stow --no-folding --dir={dotfiles} --target={home} ."


def stow(dry_run=False):
  """Runs the configured stow command. Returns True when it succeeded or nothing needed doing."""
  df = dotfiles_dir()
  if not df:
    return True
  cmd = settings().get("dotfiles", {}).get("stow", DEFAULT_STOW)
  if not cmd:
    return True
  cmd = cmd.replace("{dotfiles}", shlex.quote(str(df))).replace("{home}", shlex.quote(str(HOME)))
  if dry_run:
    print(f"would run: {cmd}")
    return True
  if not shutil.which("stow") and cmd.startswith("stow"):
    print("stow is not installed (sudo apt install stow); files were written to the dotfiles folder but not linked")
    return False
  print(f"  $ {cmd}")
  res = subprocess.run(cmd, shell=True, cwd=df, capture_output=True, text=True)
  if res.returncode != 0:
    print(res.stderr.strip() or res.stdout.strip())
    print("stow failed: files are in the dotfiles folder but some links were not made. Fix the conflicts above and "
          "run `themer apply` again.")
    return False
  return True


def link_missing(pairs):
  """After stow: links any of Themer's own files stow did not, the same relative way stow would, so the desktop
  is themed even when stow stopped on an unrelated conflict. Returns True if everything is linked."""
  ok = True
  for home_path, df_path in pairs:
    if os.path.realpath(home_path) == os.path.realpath(df_path):
      continue
    if home_path.exists() or home_path.is_symlink():
      print(f"not linked: {home_path} exists and is not a Themer file")
      ok = False
      continue
    home_path.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(os.path.relpath(df_path, os.path.realpath(home_path.parent)), home_path)
    print(f"linked {home_path} -> {df_path} (stow did not)")
  return ok


def clear_for_stow(w, home_path, df_path):
  """Makes room for stow's link at home_path. Only used on files Themer generates; the old file is backed up."""
  if not (home_path.exists() or home_path.is_symlink()):
    return
  if os.path.realpath(home_path) == os.path.realpath(df_path):
    return
  if w.dry_run:
    print(f"would replace {home_path} with a link to {df_path}")
    return
  if home_path.is_symlink():
    home_path.unlink()
  elif home_path.is_file():
    w._backup(home_path)
    home_path.unlink()


