def firefox_profile(pal):
  """The default Firefox profile: $THEMER_FIREFOX_PROFILE, [firefox] profile in settings.toml, or detected."""
  forced = os.environ.get("THEMER_FIREFOX_PROFILE") or settings().get("firefox", {}).get("profile")
  if forced:
    p = Path(os.path.expanduser(forced))
    return p if p.is_dir() else None
  roots = [HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox", HOME / "snap/firefox/common/.mozilla/firefox",
           HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox",
           HOME / ".var/app/org.mozilla.firefox/config/mozilla/firefox"]
  for root in roots:
    ini = root / "profiles.ini"
    if not ini.exists():
      continue
    _, groups, _ = parse_ini(ini.read_text())

    def kv(g):
      return dict(ln.split("=", 1) for ln in groups.get(g, []) if "=" in ln)
    for g in groups:
      if g.startswith("[Install"):
        d = kv(g).get("Default")
        if d:
          p = Path(d) if d.startswith("/") else root / d
          if p.is_dir():
            return p
    for g in groups:
      v = kv(g)
      if g.startswith("[Profile") and v.get("Default") == "1":
        p = root / v["Path"] if v.get("IsRelative", "1") == "1" else Path(v["Path"])
        if p.is_dir():
          return p
  return None


def load_targets():
  """The shipped targets, then ~/.config/themer/targets.toml on top: a user target with the name of a shipped one
  replaces it (enabled = false turns it off), any other name is added at the end."""
  targets = {t["name"]: t for t in load_toml(SELF_DIR / "targets.toml").get("target", [])}
  for d in user_dirs():
    if (d / "targets.toml").exists():
      for t in load_toml(d / "targets.toml").get("target", []):
        targets[t["name"]] = t
      break
  return list(targets.values())


def find_template(name, pal):
  """User templates override the theme's own, which override the example ones next to this script. None if absent."""
  for d in (*[u / "templates" for u in user_dirs()], pal["_dir"] / "templates", SELF_DIR / "templates"):
    if (d / name).exists():
      return d / name
  return None


def expand_path(p, ctx, pal):
  p = render(p, ctx, "output path")
  if "{firefox}" in p:
    prof = firefox_profile(pal)
    if not prof:
      return None
    p = p.replace("{firefox}", str(prof))
  return Path(os.path.expanduser(p))


def expand_outputs(p, ctx, pal):
  """The files a target writes: expand_path(), with `*`, `?` and `[...]` matched against the folders that exist, so
  one target can feed every installed version of an app. No match, nothing to write. None: no Firefox profile."""
  out = expand_path(p, ctx, pal)
  if out is None or not re.search(r"[*?\[]", str(out)):
    return None if out is None else [out]
  parts = out.parts
  last = max(i for i, part in enumerate(parts) if re.search(r"[*?\[]", part))
  return [Path(m) / Path(*parts[last + 1:]) for m in sorted(glob.glob(str(Path(*parts[:last + 1]))))]


def render_archive(folder, ctx, where):
  """A template folder as a zip (a .jar is one): every file rendered, in name order with META-INF first, with a fixed
  timestamp so an unchanged theme gives identical bytes."""
  def order(f):
    rel = f.relative_to(folder)
    return (rel.parts[0] != "META-INF", rel.as_posix())

  files = sorted((f for f in folder.rglob("*") if f.is_file()), key=order)
  buf = io.BytesIO()
  with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
    for f in files:
      rel = f.relative_to(folder).as_posix()
      try:
        data = render(f.read_text(), ctx, f"{where}/{rel}").encode()
      except UnicodeDecodeError:
        data = f.read_bytes()
      info = zipfile.ZipInfo(rel, (1980, 1, 1, 0, 0, 0))
      info.compress_type = zipfile.ZIP_DEFLATED
      info.external_attr = 0o644 << 16
      z.writestr(info, data)
  return buf.getvalue()


def run_reload(action, ctx, quiet=False):
  def have(cmd):
    return shutil.which(cmd) is not None

  def sh(*cmd):
    if not quiet:
      print("  $ " + " ".join(cmd))
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

  if action == "kde-colors":
    scheme = ctx["scheme"]
    kdeglobals = HOME / ".config/kdeglobals"
    current = None
    if kdeglobals.exists():
      _, g, _ = parse_ini(kdeglobals.read_text())
      current = next((ln.split("=", 1)[1] for ln in g.get("[General]", []) if ln.startswith("ColorScheme=")), None)
    if current != scheme and have("plasma-apply-colorscheme"):
      sh("plasma-apply-colorscheme", scheme)
    else:
      src = HOME / f".local/share/color-schemes/{scheme}.colors"
      if src.exists():
        _, g, order = parse_ini(src.read_text())
        keep = [k for k in order if k.startswith(("[Colors:", "[ColorEffects:", "[WM]"))]
        frag = "\n".join(k + "\n" + "\n".join(g[k]) for k in keep) + f"\n[General]\nColorScheme={scheme}\n"
        Writer().merge_ini(kdeglobals, frag)
        if have("dbus-send"):
          sh("dbus-send", "--session", "--type=signal", "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
             "int32:0", "int32:0")
  elif action == "kwin":
    if have("dbus-send"):
      sh("dbus-send", "--session", "--type=method_call", "--dest=org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure")
  elif action == "kde-style":
    if have("dbus-send"):
      sh("dbus-send", "--session", "--type=signal", "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
         "int32:2", "int32:0")
      # What the Fonts settings page sends: running Qt apps and Plasma re-read the fonts from kdeglobals.
      sh("dbus-send", "--session", "--type=signal", "/KDEPlatformTheme", "org.kde.KDEPlatformTheme.refreshFonts")
    if have("gdbus"):
      # KConfig's change notification, which a plain file write does not send. Plasma's GTK settings module waits for
      # it to hand the new fonts to GTK apps (and Firefox menus). Key names go as byte arrays (a{saay}).
      def ay(key):
        return "[" + ", ".join(f"byte {b:#04x}" for b in key.encode()) + "]"
      keys = ", ".join(ay(k) for k in ("font", "menuFont", "toolBarFont", "smallestReadableFont", "fixed"))
      sh("gdbus", "emit", "--session", "--object-path", "/kdeglobals", "--signal",
         "org.kde.kconfig.notify.ConfigChanged", f"{{'General': [{keys}]}}")
  elif action == "gtk":
    if have("gsettings"):
      sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
         "prefer-dark" if ctx["variant"] == "dark" else "default")
  elif action:
    if not quiet:
      print(f"  $ {action}")
    subprocess.run(action, shell=True)


# ---------------------------------------------------------------------------------------------------------------------
# State: which theme and variant are applied
