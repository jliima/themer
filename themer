# ---------------------------------------------------------------------------------------------------------------------

CHECKS = [
  # (foregrounds, grounds, minimum ratio)
  (("text", "text-muted", "text-subtle"),
   ("bg-deep", "bg-sunken", "bg", "surface", "surface-raised", "surface-hover"), 4.5),
  (("text-faint",), ("bg", "bg-sunken", "surface"), 4.5),
  (HUES, ("bg", "bg-sunken", "surface"), 4.5),
  (("line-strong",), ("bg", "bg-sunken", "surface"), 3.0),
  (("focus-ring",), ("bg-deep", "bg-sunken", "bg", "surface", "surface-raised"), 3.0),
  (("text",), ("selection", "accent-soft", "surface-active"), 4.5),
]


def cmd_check(args):
  pal, _ = pick(args)
  fails = 0
  print(f"{pal['meta']['name']}")
  for v in variants_of(pal):
    c = resolve(pal, v)
    rows = []
    for fgs, grounds, need in CHECKS:
      for fg in fgs:
        for g in grounds:
          if fg in c and g in c:
            r = contrast(c[fg], c[g])
            if r < need:
              rows.append(f"  {fg:<12} {c[fg]} on {g:<15} {c[g]}  {r:4.2f} < {need}")
    for hue in HUES:
      if hue in c and f"{hue}-soft" in c and contrast(c[hue], c[f"{hue}-soft"]) < 4.5:
        rows.append(f"  {hue} on {hue}-soft  {contrast(c[hue], c[hue + '-soft']):4.2f} < 4.5")
      if hue in c and "on-accent" in c and contrast(c["on-accent"], c[hue]) < 4.5:
        rows.append(f"  on-accent on {hue}  {contrast(c['on-accent'], c[hue]):4.2f} < 4.5")
    fails += len(rows)
    print(f"  {v}: " + ("all pairs pass" if not rows else f"{len(rows)} pairs below target"))
    if rows:
      print("\n".join(rows))
  sys.exit(1 if fails else 0)


def cmd_show(args):
  pal, variant = pick(args)
  c = resolve(pal, variant)

  def sw(h, label):
    r, g, b = (round(x * 255) for x in hex_to_rgb(h))
    fg = "0;0;0" if luminance(h) > 0.2 else "255;255;255"
    return f"\x1b[48;2;{r};{g};{b}m\x1b[38;2;{fg}m {label:<16}\x1b[0m"

  groups = [["bg-deep", "bg-sunken", "bg", "surface", "surface-raised", "surface-hover", "surface-active", "line",
             "line-strong"], ["text-disabled", "text-faint", "text-subtle", "text-muted", "text", "text-bright"]]
  groups += [[h, f"{h}-bright", f"{h}-dim", f"{h}-mid", f"{h}-soft"] for h in HUES]
  groups.append([f"ansi-{i}" for i in range(8)])
  groups.append([f"ansi-{i}" for i in range(8, 16)])
  print(f"{pal['meta']['name']} {variant}")
  for grp in groups:
    print("".join(sw(c[k], k) for k in grp if k in c))


def cmd_get(args):
  pal, variant = pick(args)
  ctx = context(pal, variant)
  expr = args.token if args.token.startswith("{{") else "{{ " + args.token + " }}"
  print(render(expr, ctx, "themer get"))


def cmd_tokens(args):
  pal, variant = pick(args)
  for k, v in resolve(pal, variant).items():
    print(f"{k:<22} {v}")


def cmd_set(args):
  """Changes one value in the theme's theme.toml in place, keeping comments. A theme given by path is copied to your
  themes folder first."""
  pal, variant = pick(args)
  if parse_color(args.value) is None and not ALIAS_RE.match(args.value):
    die("value must be #rrggbb, oklch(L C H) or {token}")
  path = pal["_path"] if is_user_path(pal["_path"]) else user_copy(pal["meta"]["id"])
  lines = path.read_text().splitlines()
  target = args.section or variant
  section, done = None, False
  for i, ln in enumerate(lines):
    m = re.match(r"^\[([\w.-]+)\]", ln)
    if m:
      section = m.group(1)
      continue
    if section == target and re.match(rf"^{re.escape(args.token)}\s*=", ln):
      cm = re.match(r'^[^=]+=\s*(?:"(?:[^"\\]|\\.)*"|[^#\s]*)\s*(#.*)?$', ln)
      comment = cm.group(1) if cm and cm.group(1) else ""
      lines[i] = f'{args.token} = "{args.value}"' + (f"  {comment}" if comment else "")
      done = True
      break
  if not done:
    idx = next((i for i, ln in enumerate(lines) if ln.strip() == f"[{target}]"), None)
    if idx is None:
      lines += ["", f"[{target}]"]
      idx = len(lines) - 1
    lines.insert(idx + 1, f'{args.token} = "{args.value}"')
  path.write_text("\n".join(lines) + "\n")
  print(f"{pal['meta']['id']} [{target}] {args.token} = {args.value}  ({path})")


def cmd_undo(args):
  root = STATE_DIR / "backups"
  runs = sorted(p for p in root.iterdir() if p.is_dir()) if root.exists() else []
  if not runs:
    die("no backups yet")
  run = runs[-1]
  for f in run.rglob("*"):
    if f.is_file():
      dest = Path("/") / f.relative_to(run)
      print(f"restore {dest}")
      if not args.dry_run:
        shutil.copy2(f, dest)
  if not args.dry_run:
    shutil.rmtree(run)


# ---------------------------------------------------------------------------------------------------------------------
# Import a design system's tokens.json as a theme
# ---------------------------------------------------------------------------------------------------------------------

SECTION_TITLES = {"bg": "Grounds, deepest to highest", "surface": "Surfaces", "line": "Lines",
                  "text": "Text, brightest last", "red": "Red", "orange": "Orange", "yellow": "Yellow",
                  "green": "Green", "cyan": "Cyan", "blue": "Blue", "violet": "Violet", "magenta": "Magenta",
                  "on": "Text on solid hue fills", "selection": "Selection", "ansi": "Terminal colors 0 to 15"}


def theme_toml_from_tokens(tk, tid, name, description):
  """theme.toml text from a design system tokens.json (lists of {name, value: {dark, light}, usage})."""
  toks = tk["color"]["tokens"]
  variants = [t["id"] for t in tk["color"].get("themes", [{"id": "dark"}]) if t["id"] in VARIANTS]
  out = [THEME_HEADER.format(name=name, id=tid),
         "[meta]", f'id = "{tid}"', f'name = "{name}"', f'description = "{description}"', 'version = "1.0.0"',
         f"variants = {json.dumps(variants)}", f'default-variant = "{variants[0]}"', ""]
  fams = tk.get("type", {}).get("families", {})

  def first_family(stack):
    m = re.match(r'\s*"?([^",]+)"?', stack or "")
    return m.group(1).strip() if m else None
  styles = {st["name"]: st for g in tk.get("type", {}).get("groups", []) for st in g.get("styles", [])}
  out += ["[fonts]", f'sans = "{first_family(fams.get("sans")) or "Noto Sans"}"',
          f'mono = "{first_family(fams.get("mono")) or "Hack"}"']
  try:
    ui = int(float(str(styles["body"]["fontWeight"]).split()[0]))
    out += [f"ui-weight = {ui}            # from the design system's body style",
            f"title-weight = {min(ui + 100, 700)}"]
  except (KeyError, ValueError):
    pass
  out.append("")
  radii = {t["name"]: t["value"] for t in tk.get("radius", {}).get("tokens", [])}
  if radii:
    out.append("[shape]")
    for k in ("radius-xs", "radius-sm", "radius-md", "radius-lg"):
      if k in radii:
        out.append(f"{k} = {int(float(str(radii[k]).rstrip('px')))}")
    out.append("")

  def val(t, v):
    return t["value"].get(v) if isinstance(t["value"], dict) else t["value"]
  common = [t for t in toks if all(str(val(t, v)).startswith("{") and val(t, v) == val(t, variants[0])
                                   for v in variants)]
  names = {t["name"] for t in common}
  out.append("# Roles: what each color is for. A variant table can override any of them.\n[roles]")
  out += [f'{t["name"]} = "{val(t, variants[0])}"' for t in common]
  for v in variants:
    out.append(f"\n[{v}]")
    cur = None
    for t in toks:
      if t["name"] in names:
        continue
      x = val(t, v)
      if t["name"].startswith("ansi-") or t["name"] == "text-inverse":
        same = next((o["name"] for o in toks if o["name"] not in names
                     and not o["name"].startswith(("ansi-", "text-inverse")) and val(o, v) == x), None)
        x = f"{{{same}}}" if same else x
      grp = "ansi" if t["name"].startswith("ansi-") else t["name"].split("-")[0]
      if grp != cur:
        cur = grp
        out.append(f"# {SECTION_TITLES.get(grp, grp)}")
      out.append(f'{t["name"]} = "{x}"')
  return "\n".join(out) + "\n"


THEME_HEADER = """# {name}: a Themer theme.
#
#   themer apply --theme {id}             apply it (themer apply --theme {id}:light for the light variant)
#   themer check --theme {id}             contrast report
#   themer validate --theme {id}          check it fills the token contract (contract.toml)
#
# Values: "#rrggbb", "oklch(L C H)" (L 0..1, C about 0..0.37, H degrees), or "{{other-token}}".
# Anything left out falls back to defaults.toml: roles, syntax colors, terminal colors, fonts, shapes.
# Each hue may also define -bright, -dim, -mid and -soft; leave them out and Themer derives them from the base hue.
"""


def cmd_import(args):
  tk = json.load(open(os.path.expanduser(args.tokens)))
  tid = args.id
  if not ID_RE.match(tid):
    die("theme ids are lowercase letters, digits, - and _")
  name = args.name or tk.get("name") or tid.title()
  text = theme_toml_from_tokens(tk, tid, name, args.description or f"Imported from {Path(args.tokens).name}")
  if args.output == "-":
    sys.stdout.write(text)
    return
  dest = Path(args.output) if args.output else user_dir() / "themes" / tid / "theme.toml"
  if dest.exists() and not args.replace:
    die(f"{dest} exists (--replace to overwrite)")
  if dest.exists():
    text = keep_settings(text, load_toml(dest))
  dest.parent.mkdir(parents=True, exist_ok=True)
  dest.write_text(text)
  stow()
  print(f"wrote {dest}")


def keep_settings(text, old):
  """On --replace, carries over keys of the old theme's non-color tables (fonts, shape, kde, konsole, firefox)
  that the import does not set, such as fonts.ui-weight."""
  new = tomllib.loads(text)
  for table, values in old.items():
    if table in VARIANTS or table in ("roles", "meta") or not isinstance(values, dict):
      continue
    extra = {k: v for k, v in values.items() if k not in new.get(table, {}) and not isinstance(v, dict)}
    if not extra:
      continue
    lines = [f"{k} = {json.dumps(v)}" for k, v in extra.items()]
    m = re.search(rf"(?m)^\[{re.escape(table)}\]\n(?:[^\[\n].*\n|\n)*?(?=\n|\[|\Z)", text)
    if m:
      text = text[:m.end()] + "\n".join(lines) + "\n" + text[m.end():]
    else:
      text = text.replace("\n# Roles:", f"\n[{table}]\n" + "\n".join(lines) + "\n\n# Roles:", 1)
  return text


