def cmd_themes(args):
  state = read_state()
  rows = []
  for tid, path in sorted(all_themes().items()):
    try:
      pal = load_theme(str(path))
    except SystemExit as e:
      rows.append((tid, "", "", f"broken: {e}", ""))
      continue
    m = pal["meta"]
    where = "bundled"
    if is_user_path(path):
      where = "edited" if (SELF_DIR / "themes" / tid / "theme.toml").exists() else "user"
    mark = "*" if state.get("theme") == tid else " "
    rows.append((f"{mark} {tid}", m["name"], "/".join(m["variants"]), m.get("description", ""), where))
  if not rows:
    print("no themes installed")
    return
  w = [max(len(r[i]) for r in rows) for i in range(3)]
  for r in rows:
    print(f"{r[0]:<{w[0]}}  {r[1]:<{w[1]}}  {r[2]:<{w[2]}}  {r[4]:<8} {r[3]}")
  if state.get("theme"):
    print(f"\n* applied: {state['theme']} {state.get('variant', '')}")


def cmd_current(args):
  s = read_state()
  print(f"{s['theme']} {s.get('variant', '')}" if s.get("theme") else "nothing applied yet")


def user_copy(tid):
  """Makes sure a theme lives in ~/.config/themer/themes so it can be edited. Returns its theme.toml."""
  dest = user_dir() / "themes" / tid
  if (dest / "theme.toml").exists():
    return dest / "theme.toml"
  src = theme_path(tid).parent
  shutil.copytree(src, dest)
  stow()
  print(f"copied {tid} to {dest} for editing (the bundled copy stays untouched)")
  return dest / "theme.toml"


def cmd_edit(args):
  path = user_copy(args.theme or read_state().get("theme") or die("which theme? themer edit <name>"))
  editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
  if editor and not args.print:
    subprocess.run([*editor.split(), str(path)])
  else:
    print(path)


def cmd_new(args):
  if not ID_RE.match(args.id):
    die("theme ids are lowercase letters, digits, - and _")
  dest = user_dir() / "themes" / args.id
  if dest.exists():
    die(f"{dest} already exists")
  src = theme_path(args.base).parent
  shutil.copytree(src, dest, ignore=shutil.ignore_patterns("README.md", "preview*"))
  path = dest / "theme.toml"
  text = path.read_text()
  name = args.name or args.id.replace("-", " ").title()
  text = re.sub(r'(?m)^id = ".*"$', f'id = "{args.id}"', text, count=1)
  text = re.sub(r'(?m)^name = ".*"$', f'name = "{name}"', text, count=1)
  text = re.sub(r'(?m)^description = ".*"$', f'description = "Based on {args.base}"', text, count=1)
  path.write_text(text)
  stow()
  print(f"created {path}\nEdit it, then: themer check --theme {args.id} && themer apply --theme {args.id}")


def cmd_install(args):
  src = Path(os.path.expanduser(args.source))
  if src.is_file() and src.suffix == ".zip":
    import zipfile
    import tempfile
    tmp = Path(tempfile.mkdtemp(prefix="themer-"))
    with zipfile.ZipFile(src) as z:
      for n in z.namelist():
        if n.startswith("/") or ".." in Path(n).parts:
          die(f"refusing unsafe path in zip: {n}")
      z.extractall(tmp)
    found = list(tmp.rglob("theme.toml"))
    if len(found) != 1:
      die(f"expected one theme.toml in {src}, found {len(found)}")
    src = found[0].parent
  elif src.is_file() and src.name.endswith(".toml"):
    src = src.parent if src.name == "theme.toml" else src
  if src.is_file():
    data = load_toml(src)
    tid = args.id or data.get("meta", {}).get("id") or src.stem
    dest = user_dir() / "themes" / tid
    dest.mkdir(parents=True, exist_ok=bool(args.replace))
    shutil.copy2(src, dest / "theme.toml")
  else:
    if not (src / "theme.toml").exists():
      die(f"{src} has no theme.toml")
    tid = args.id or load_toml(src / "theme.toml").get("meta", {}).get("id") or src.name
    dest = user_dir() / "themes" / tid
    if dest.exists():
      if not args.replace:
        die(f"{tid} is already installed at {dest} (--replace to overwrite)")
      shutil.rmtree(dest)
    shutil.copytree(src, dest)
  if not ID_RE.match(tid):
    die(f"bad theme id {tid!r}")
  stow()
  pal = load_theme(str(dest / "theme.toml"))
  problems = validate(pal)
  print(f"installed {tid} -> {dest}")
  print("contract: ok" if not problems else "contract problems:\n  " + "\n  ".join(problems))


def cmd_remove(args):
  dest = user_dir() / "themes" / args.id
  if not dest.exists():
    die(f"{args.id} is not a user theme (bundled themes cannot be removed)")
  shutil.rmtree(dest)
  link = CONFIG_DIR / "themes" / args.id
  if link.is_symlink():
    link.unlink()
  print(f"removed {dest}" + (" (the bundled copy is used again)" if (SELF_DIR / "themes" / args.id).exists() else ""))


def cmd_validate(args):
  pal, _ = pick(args)
  problems = validate(pal)
  m = pal["meta"]
  print(f"{m['id']} ({m['name']}), variants: {', '.join(m['variants'])}, file: {pal['_path']}")
  req = contract().get("required", {})
  total = sum(len(v) for v in req.values())
  if problems:
    print("\n".join("  " + p for p in problems))
    sys.exit(1)
  print(f"  all {total} required tokens resolve in every variant")


