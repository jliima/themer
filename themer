# ---------------------------------------------------------------------------------------------------------------------
# Writing: plain files, KDE ini merges, line ensures, with backups
# ---------------------------------------------------------------------------------------------------------------------

class Writer:
  def __init__(self, dry_run=False, verbose=False):
    self.dry_run = dry_run
    self.verbose = verbose
    self.stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    self.backup_root = STATE_DIR / "backups" / self.stamp
    self.changed = []

  def _backup(self, path):
    if path.exists():
      dest = self.backup_root / str(path).lstrip("/")
      dest.parent.mkdir(parents=True, exist_ok=True)
      shutil.copy2(path, dest)

  def write(self, path, text):
    path = Path(path)
    if path.is_symlink():
      # A stowed file: write into the dotfiles copy instead of replacing the link.
      path = Path(os.path.realpath(path))
    old = path.read_text() if path.exists() else None
    if old == text:
      return False
    self.changed.append(path)
    if self.dry_run:
      return True
    self._backup(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".themer-tmp")
    tmp.write_text(text)
    os.replace(tmp, path)
    return True

  def merge_ini(self, path, fragment):
    """Sets the keys of an ini fragment in an existing KDE config file, keeping everything else.
    A value of @delete removes the key."""
    path = Path(path)
    text = path.read_text() if path.exists() else ""
    return self.write(path, merge_ini_text(text, fragment))

  def ensure_lines(self, path, fragment):
    """Appends each line of fragment that is missing; a line with the same key prefix (up to the first comma or =)
    is replaced instead."""
    path = Path(path)
    lines = path.read_text().splitlines() if path.exists() else []
    for want in [ln for ln in fragment.splitlines() if ln.strip() and not ln.startswith("//")]:
      key = re.split(r"[,=]", want, maxsplit=1)[0]
      idx = next((i for i, ln in enumerate(lines) if ln.startswith(key)), None)
      if idx is None:
        lines.append(want)
      else:
        lines[idx] = want
    return self.write(path, "\n".join(lines) + "\n")


def parse_ini(text):
  groups, order, cur = {}, [], None
  head = []
  for ln in text.splitlines():
    if re.match(r"^\[.*\]\s*$", ln):
      cur = ln.strip()
      if cur not in groups:
        groups[cur] = []
        order.append(cur)
    elif cur is None:
      head.append(ln)
    else:
      groups[cur].append(ln)
  return head, groups, order


def merge_ini_text(text, fragment):
  head, groups, order = parse_ini(text)
  _, fgroups, forder = parse_ini(fragment)
  for g in forder:
    lines = groups.setdefault(g, [])
    if g not in order:
      order.append(g)
    for ln in fgroups[g]:
      if "=" not in ln or ln.lstrip().startswith(("#", ";")):
        continue
      key, val = ln.split("=", 1)
      key = key.strip()
      idx = next((i for i, x in enumerate(lines) if "=" in x and re.sub(r"\[\$\w+\]$", "", x.split("=", 1)[0].strip())
                  == key), None)
      if val.strip() == "@delete":
        if idx is not None:
          lines.pop(idx)
        continue
      if idx is None:
        while lines and not lines[-1].strip():
          lines.pop()
        lines.append(f"{key}={val}")
      else:
        lines[idx] = f"{key}={val}"
  out = list(head)
  for g in order:
    body = groups[g]
    while body and not body[-1].strip():
      body.pop()
    if out and out[-1].strip():
      out.append("")
    out.append(g)
    out += body
  return "\n".join(out).strip("\n") + "\n"



