#!/usr/bin/env python3
"""Themer: install a design system's colors, fonts and shapes into every app on the desktop.

A theme is a folder with a theme.toml that fills in the Themer token contract (bg, surface, text, eight hues, roles,
syntax and terminal colors) for one or more variants (dark, light). Themer resolves those tokens, renders the
templates listed in targets.toml for Plasma, Darkly, Konsole, Kate, GTK, Firefox and anything else, installs them
and reloads what can be reloaded.

  themer apply --theme pare            apply a theme (its default variant)
  themer apply --theme pare --variant light
  themer mode toggle                   switch the current theme between dark and light

Python 3.11+ standard library only.
"""

import argparse
import datetime as _dt
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

VERSION = "2.0.0"
HOME = Path.home()
SELF_DIR = Path(__file__).resolve().parent
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "themer"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "themer"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "themer"
VARIANTS = ("dark", "light")
HUES = ("red", "orange", "yellow", "green", "cyan", "blue", "violet", "magenta")
STEPS = ("bright", "dim", "soft")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,40}$")


def die(msg):
  sys.exit(f"themer: {msg}")

# ---------------------------------------------------------------------------------------------------------------------
# Color math: sRGB <-> OKLab/OKLCH, gamut mapping, WCAG contrast
# ---------------------------------------------------------------------------------------------------------------------

def _lin(c):
  return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _gam(c):
  return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def hex_to_rgb(h):
  h = h.lstrip("#")
  if len(h) == 3:
    h = "".join(ch * 2 for ch in h)
  return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb_to_hex(rgb):
  return "#" + "".join(f"{round(max(0, min(1, c)) * 255):02x}" for c in rgb)


def rgb_to_oklab(rgb):
  r, g, b = (_lin(c) for c in rgb)
  l_ = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
  m_ = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
  s_ = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
  return (0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
          1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
          0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_)


def oklab_to_rgb_linear(lab):
  L, a, b = lab
  l_ = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
  m_ = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
  s_ = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
  return (4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
          -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
          -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_)


def oklch_to_hex(L, C, H):
  """Gamut-maps by lowering chroma until the color fits sRGB."""
  L = max(0.0, min(1.0, L))

  def lin(c):
    return oklab_to_rgb_linear((L, c * math.cos(math.radians(H)), c * math.sin(math.radians(H))))

  def ok(rgb):
    return all(-1e-4 <= v <= 1 + 1e-4 for v in rgb)

  if not ok(lin(C)):
    lo, hi = 0.0, C
    for _ in range(30):
      mid = (lo + hi) / 2
      lo, hi = (mid, hi) if ok(lin(mid)) else (lo, mid)
    C = lo
  return rgb_to_hex(tuple(_gam(max(0.0, v)) for v in lin(C)))


def hex_to_oklch(h):
  L, a, b = rgb_to_oklab(hex_to_rgb(h))
  return L, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


def luminance(h):
  r, g, b = (_lin(c) for c in hex_to_rgb(h))
  return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
  la, lb = sorted((luminance(a), luminance(b)), reverse=True)
  return (la + 0.05) / (lb + 0.05)


def mix(a, b, t):
  """Mixes a toward b by t (0..1) in OKLab."""
  la, lb = rgb_to_oklab(hex_to_rgb(a)), rgb_to_oklab(hex_to_rgb(b))
  lab = tuple(x + (y - x) * t for x, y in zip(la, lb))
  return rgb_to_hex(tuple(_gam(max(0.0, min(1.0, v))) for v in oklab_to_rgb_linear(lab)))


def shift_l(h, dl):
  L, C, H = hex_to_oklch(h)
  return oklch_to_hex(L + dl, C, H)


COLOR_RE = re.compile(r"^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$")
OKLCH_RE = re.compile(r"^oklch\(\s*([\d.]+)(%?)\s+([\d.]+)\s+([\d.]+)\s*\)$")
ALIAS_RE = re.compile(r"^\{([\w.-]+)\}$")


def parse_color(v):
  v = v.strip()
  if COLOR_RE.match(v):
    return rgb_to_hex(hex_to_rgb(v))
  m = OKLCH_RE.match(v)
  if m:
    L = float(m.group(1)) / (100 if m.group(2) else 1)
    return oklch_to_hex(L, float(m.group(3)), float(m.group(4)))
  return None


# ---------------------------------------------------------------------------------------------------------------------
# Settings and where user files live
# ---------------------------------------------------------------------------------------------------------------------

def load_toml(path):
  with open(path, "rb") as f:
    return tomllib.load(f)


_SETTINGS = None


def settings():
  """Machine settings (settings.toml): ~/.config/themer first, then the dotfiles copy next to this script, so a
  fresh dotfiles checkout works before it is stowed."""
  global _SETTINGS
  if _SETTINGS is None:
    _SETTINGS = {}
    env = os.environ.get("THEMER_SETTINGS")
    for f in ([Path(env)] if env else []) + [CONFIG_DIR / "settings.toml",
                                             SELF_DIR.parent / ".config/themer/settings.toml"]:
      if f.exists():
        _SETTINGS = load_toml(f)
        break
  return _SETTINGS


def dotfiles_dir():
  """The stow directory (for example ~/dotfiles) when [dotfiles] is enabled, else None."""
  d = settings().get("dotfiles", {})
  if not d.get("enabled", False):
    return None
  return Path(os.path.expanduser(d.get("path", "~/dotfiles")))


def home_rel(p):
  try:
    return Path(p).relative_to(HOME)
  except ValueError:
    return None


def user_dir():
  """Where Themer keeps your themes, templates, snippets and settings. With dotfiles on, the dotfiles copy of
  ~/.config/themer, so new files land in the repo even before stow links them."""
  df = dotfiles_dir()
  rel = home_rel(CONFIG_DIR) or Path(".config/themer")
  return df / rel if df else CONFIG_DIR


def user_dirs():
  """user_dir() plus ~/.config/themer when they differ, without duplicates."""
  out = []
  for d in (user_dir(), CONFIG_DIR):
    if all(os.path.realpath(d) != os.path.realpath(o) for o in out):
      out.append(d)
  return out


def is_user_path(p):
  rp = os.path.realpath(p)
  return any(rp.startswith(os.path.realpath(d) + os.sep) for d in user_dirs())


# ---------------------------------------------------------------------------------------------------------------------
# Themes: folders with a theme.toml, found in your themes folder first, then next to this script
# ---------------------------------------------------------------------------------------------------------------------

def theme_dirs():
  return [d / "themes" for d in user_dirs()] + [SELF_DIR / "themes"]


def find_config(name):
  for d in (*user_dirs(), SELF_DIR):
    if (d / name).exists():
      return d / name
  die(f"{name} not found in {', '.join(str(d) for d in (*user_dirs(), SELF_DIR))}")


def theme_path(ref):
  """A theme id (pare), a folder with theme.toml, or a theme.toml file."""
  p = Path(os.path.expanduser(ref))
  if p.is_file():
    return p
  if p.is_dir() and (p / "theme.toml").exists():
    return p / "theme.toml"
  for d in theme_dirs():
    if (d / ref / "theme.toml").exists():
      return d / ref / "theme.toml"
  known = ", ".join(sorted(all_themes())) or "none"
  die(f"no theme '{ref}'. Installed themes: {known}")


def all_themes():
  """{id: path} with user themes shadowing bundled ones."""
  found = {}
  for d in reversed(theme_dirs()):
    if d.is_dir():
      for sub in sorted(d.iterdir()):
        if (sub / "theme.toml").exists():
          found[sub.name] = sub / "theme.toml"
  return found


def load_theme(ref):
  """Loads a theme and layers it over defaults.toml. Returns the merged dict ("pal")."""
  path = theme_path(ref)
  data = load_toml(path)
  defaults = load_toml(find_config("defaults.toml"))
  pal = {}
  for section in set(defaults) | set(data):
    a, b = defaults.get(section, {}), data.get(section, {})
    if section in VARIANTS or section == "roles":
      pal[section] = b
    elif isinstance(a, dict) or isinstance(b, dict):
      pal[section] = {**a, **b}
    else:
      pal[section] = b if section in data else a
  meta = pal.setdefault("meta", {})
  meta.setdefault("id", path.parent.name)
  meta.setdefault("name", meta["id"].capitalize())
  variants = [v for v in meta.get("variants", VARIANTS) if v in data]
  if not variants:
    die(f"theme {meta['id']} has no [dark] or [light] table")
  meta["variants"] = variants
  if meta.get("default-variant") not in variants:
    meta["default-variant"] = variants[0]
  pal["_defaults"] = defaults
  pal["_path"] = path
  pal["_dir"] = path.parent
  return pal


def variants_of(pal):
  return pal["meta"]["variants"]


def derive_step(base, step, variant):
  L, C, H = hex_to_oklch(base)
  if variant == "dark":
    if step == "bright":
      return oklch_to_hex(min(L + 0.07, 0.93), C * 0.9, H)
    if step == "dim":
      return oklch_to_hex(0.52, C * 0.75, H)
    return oklch_to_hex(0.27, min(C * 0.4, 0.065), H)
  if step == "bright":
    return oklch_to_hex(L - 0.07, C * 0.95, H)
  if step == "dim":
    return oklch_to_hex(min(L + 0.14, 0.82), C * 0.7, H)
  return oklch_to_hex(0.94, min(C * 0.25, 0.04), H)


def raw_tokens(pal, variant):
  """Every token's source value, by precedence: theme [variant], theme [roles], defaults [variant], defaults [roles]."""
  if variant not in variants_of(pal):
    die(f"theme {pal['meta']['id']} has no {variant} variant (it has: {', '.join(variants_of(pal))})")
  d = pal["_defaults"]
  raw = {}
  for layer in (pal.get(variant, {}), pal.get("roles", {}), d.get(variant, {}), d.get("roles", {})):
    for k, v in layer.items():
      if not isinstance(v, dict):
        raw.setdefault(k, v)
  for hue in HUES:
    if hue in raw:
      for step in STEPS:
        raw.setdefault(f"{hue}-{step}", f"@derive:{hue}:{step}")
  return raw


def resolve(pal, variant):
  """Returns {token: '#rrggbb'} for one variant, aliases followed and hue steps derived."""
  raw = raw_tokens(pal, variant)
  out, stack = {}, []
  tid = pal["meta"]["id"]

  def get(name):
    if name in out:
      return out[name]
    if name not in raw:
      raise KeyError(name)
    if name in stack:
      die(f"{tid} [{variant}]: alias loop at {' -> '.join(stack + [name])}")
    stack.append(name)
    v = str(raw[name])
    if v.startswith("@derive:"):
      _, hue, step = v.split(":")
      val = derive_step(get(hue), step, variant)
    elif ALIAS_RE.match(v):
      ref = ALIAS_RE.match(v).group(1)
      try:
        val = get(ref)
      except KeyError:
        die(f"{tid} [{variant}]: {name} points to {{{ref}}}, which the theme does not define")
    else:
      val = parse_color(v)
      if val is None:
        die(f"{tid} [{variant}]: {name} = {v!r} is not a color (use #rrggbb, oklch(L C H) or {{token}})")
    stack.pop()
    out[name] = val
    return val

  for k in list(raw):
    try:
      get(k)
    except KeyError:
      pass
  return {k: out[k] for k in raw if k in out}


def context(pal, variant):
  """Everything a template can reach: colors plus fonts, shape, app settings and names."""
  ctx = dict(resolve(pal, variant))
  meta = pal["meta"]
  ctx.update({"variant": variant, "Variant": variant.capitalize(), "theme": meta["id"], "name": meta["name"],
              "scheme": f"{meta['name'].replace(' ', '')}{variant.capitalize()}",
              "is-dark": 1 if variant == "dark" else 0, "is-light": 0 if variant == "dark" else 1,
              "dark-suffix": "Dark" if variant == "dark" else "",
              "dark-bool": "true" if variant == "dark" else "false"})
  for section, values in pal.items():
    if isinstance(values, dict) and section not in VARIANTS and section not in ("roles", "meta", "_defaults"):
      for k, v in values.items():
        if not isinstance(v, dict):
          ctx[f"{section}.{k}"] = v
  # Machine settings win over every theme, e.g. [overrides.kde] decoration-library = "themer".
  for section, values in settings().get("overrides", {}).items():
    if isinstance(values, dict):
      for k, v in values.items():
        ctx[f"{section}.{k}"] = v
  # A widget style can have a dark twin (Kvantum: kvantum-dark loads <theme>Dark); switching the style name is also
  # what makes running KDE apps restyle when the variant changes.
  if variant == "dark" and ctx.get("kde.widget-style-dark"):
    ctx["kde.widget-style"] = ctx["kde.widget-style-dark"]
  for kind in ("chrome", "content"):
    ctx[f"firefox-{kind}-imports"], ctx[f"firefox-{kind}-snippets"] = firefox_snippets(pal, kind, ctx)
  return ctx


def snippet_files(pal, kind):
  """Firefox CSS snippets, by file name: the theme's firefox/<kind>/ first, then yours (same name wins).
  Files starting with _ or ending in .disabled are skipped."""
  found = {}
  for d in (pal["_dir"] / "firefox" / kind, *[u / "firefox" / kind for u in reversed(user_dirs())]):
    if d.is_dir():
      for f in sorted(d.iterdir()):
        if f.suffix == ".css" and f.is_file() and not f.name.startswith("_"):
          found[f.name] = f
  return [found[k] for k in sorted(found)]


IMPORT_RE = re.compile(r"^\s*@(?:import|namespace)\b[^;]*;\s*$", re.M)


def firefox_snippets(pal, kind, ctx):
  """(imports, body): the snippets of one kind joined for the end of userChrome.css or userContent.css.
  @import and @namespace lines are pulled out, because CSS only accepts them at the top of the file."""
  files = snippet_files(pal, kind)
  if not files:
    where = str(user_dir() / "firefox" / kind).replace(str(HOME), "~", 1)
    return "", f"/* No {kind} snippets. Add .css files to {where}. */"
  imports, parts = [], []
  for f in files:
    try:
      body = render(f.read_text(), ctx, str(f))
    except KeyError as e:
      die(f"Firefox snippet {e.args[0]}")
    imports += [m.group(0).strip() for m in IMPORT_RE.finditer(body)]
    body = IMPORT_RE.sub("", body)
    where = str(f.parent).replace(str(HOME), "~", 1)
    parts.append(f"/* ---- snippet: {f.name} ({where}) ---- */\n{body.strip()}\n")
  return "\n".join(dict.fromkeys(imports)), "\n".join(parts)


def contract():
  return load_toml(find_config("contract.toml"))


def validate(pal):
  """Problems that would break templates: missing required tokens and unresolvable values, per variant."""
  req = contract()
  problems = []
  for v in variants_of(pal):
    toks = resolve(pal, v)
    for group, names in req.get("required", {}).items():
      missing = [n for n in names if n not in toks]
      if missing:
        problems.append(f"[{v}] missing {group}: {', '.join(missing)}")
  return problems

# ---------------------------------------------------------------------------------------------------------------------
# Templates: {{ token }}, {{ token | filter | filter(arg) }}
# ---------------------------------------------------------------------------------------------------------------------

TAG_RE = re.compile(r"\{\{\s*([\w.-]+)((?:\s*\|\s*[\w-]+(?:\([^)]*\))?)*)\s*\}\}")
FILTER_RE = re.compile(r"\|\s*([\w-]+)(?:\(([^)]*)\))?")


def _arg_color(ctx, a):
  a = a.strip().strip("\"'")
  return ctx[a] if a in ctx else parse_color(a)


def apply_filter(ctx, value, name, arg):
  is_color = isinstance(value, str) and COLOR_RE.match(value)
  if name == "hex":
    return value
  if name == "strip":
    return value.lstrip("#")
  if name == "upper":
    return str(value).upper()
  if name == "lower":
    return str(value).lower()
  if is_color:
    r, g, b = (round(c * 255) for c in hex_to_rgb(value))
    if name == "rgb":
      return f"{r},{g},{b}"
    if name == "rgbcss":
      return f"rgb({r}, {g}, {b})"
    if name == "rgba":
      return f"rgba({r}, {g}, {b}, {float(arg)})"
    if name == "alpha":
      return f"{value}{round(float(arg) * 255):02x}"
    if name == "mix":
      other, t = arg.rsplit(",", 1)
      return mix(value, _arg_color(ctx, other), float(t))
    if name == "lighten":
      return shift_l(value, float(arg))
    if name == "darken":
      return shift_l(value, -float(arg))
    if name == "oklch":
      L, C, H = hex_to_oklch(value)
      return f"oklch({L:.3f} {C:.3f} {H:.1f})"
  if name == "px":
    return f"{value}px"
  if name == "int":
    return str(int(float(value)))
  if name == "div":
    return f"{float(value) / float(arg):g}"
  if name == "add":
    return f"{float(value) + float(ctx[arg] if arg in ctx else arg):g}"
  raise ValueError(f"unknown filter '{name}' for value {value!r}")


def render(text, ctx, where="template"):
  def sub(m):
    key, filters = m.group(1), m.group(2)
    if key not in ctx:
      raise KeyError(f"{where}: unknown token '{key}'")
    v = ctx[key]
    for fm in FILTER_RE.finditer(filters):
      v = apply_filter(ctx, v, fm.group(1), fm.group(2))
    return str(v)
  return TAG_RE.sub(sub, text)


# ---------------------------------------------------------------------------------------------------------------------
# Built-in formats
# ---------------------------------------------------------------------------------------------------------------------

def fmt_json(pal, theme):
  out = {"name": pal["meta"]["name"], "theme": pal["meta"]["id"], "variant": theme, "colors": resolve(pal, theme),
         "fonts": pal.get("fonts", {}), "shape": pal.get("shape", {})}
  return json.dumps(out, indent=2) + "\n"


def fmt_css(pal, theme):
  lines = ["/* Generated by Themer. Do not edit; change the theme and run `themer apply`. */"]
  for i, th in enumerate(variants_of(pal)):
    sel = f':root, :root[data-theme="{th}"]' if th == theme else f':root[data-theme="{th}"]'
    lines.append(sel + " {")
    lines += [f"  --themer-{k}: {v};" for k, v in resolve(pal, th).items()]
    lines.append("}")
  lines.append(":root {")
  for k, v in pal.get("fonts", {}).items():
    lines.append(f"  --themer-font-{k}: {json.dumps(v) if isinstance(v, str) else v};")
  for k, v in pal.get("shape", {}).items():
    lines.append(f"  --themer-{k}: {v}px;")
  lines.append("}")
  return "\n".join(lines) + "\n"


def fmt_sh(pal, theme):
  c = resolve(pal, theme)
  lines = ["# Generated by Themer. Source it: . ~/.cache/themer/colors.sh", f"THEMER_THEME='{pal['meta']['id']}'",
           f"THEMER_VARIANT='{theme}'"]
  lines += [f"THEMER_{k.upper().replace('-', '_')}='{v}'" for k, v in c.items()]
  lines += [f"color{i}='{c[f'ansi-{i}']}'" for i in range(16)]
  lines += [f"background='{c['bg']}'", f"foreground='{c['text']}'", f"cursor='{c['text']}'"]
  lines.append("export THEMER_THEME THEMER_VARIANT " + " ".join(f"THEMER_{k.upper().replace('-', '_')}" for k in c))
  return "\n".join(lines) + "\n"


def fmt_pywal(pal, theme):
  """pywal colors.json, with the extended keys of the original parecolors.json so old templates keep working."""
  c = resolve(pal, theme)
  dark = theme == "dark"

  def ramp(hue):
    L, C, H = hex_to_oklch(c[hue])
    mid = oklch_to_hex(0.38, C * 0.6, H) if dark else oklch_to_hex(0.87, C * 0.4, H)
    return [c[f"{hue}-soft"], mid, c[f"{hue}-dim"], mix(c[f"{hue}-dim"], c[hue], 0.5), c[hue]]

  sp = {"background": c["bg"], "foreground": c["text"], "cursor": c["text"]}
  for i, k in enumerate(("bg-deep", "bg-sunken", "bg", "surface", "surface-raised")):
    sp[f"black{i + 1}"] = c[k]
  for i, v in enumerate((c["text-subtle"], c["text-muted"], mix(c["text-muted"], c["text"], 0.5), c["text"],
                         c["text-bright"])):
    sp[f"white{i + 1}"] = v
  greys = (c["surface-hover"], c["surface-active"], oklch_to_hex(0.36 if dark else 0.82, 0.024, 248),
           oklch_to_hex(0.44 if dark else 0.72, 0.026, 248), c["line-strong"])
  for i, v in enumerate(greys):
    sp[f"grey{i + 1}"] = v
  for hue in ("red", "green", "blue", "yellow", "cyan", "magenta", "orange", "violet"):
    for i, v in enumerate(ramp(hue)):
      sp[f"{hue}{i + 1}"] = v
  sem = {"backgroundAlt": "bg-sunken", "surface": "surface", "surfaceHover": "surface-hover",
         "overlay": "surface-raised", "accent": "accent", "accentHover": "accent-hover", "accentSubtle": "accent-soft",
         "textSecondary": "text-muted",
         "textMuted": "text-subtle", "textDisabled": "text-disabled", "textInverse": "on-accent", "textLink": "link",
         "border": "line", "borderSubtle": "surface-hover", "borderStrong": "line-strong", "borderFocus": "focus-ring",
         "selection": "selection", "highlight": "surface-hover", "highlightActive": "surface-active",
         "success": "success", "warning": "warning", "error": "danger", "info": "info"}
  for k, v in sem.items():
    sp[k] = c[v]
  syn = {"Keyword": "keyword", "String": "string", "Comment": "comment", "Number": "number", "Function": "function",
         "Class": "class", "Type": "type", "Constant": "constant", "Variable": "variable", "Operator": "operator",
         "Annotation": "annotation", "DocTag": "doc-tag", "StringEscape": "escape", "Punctuation": "punctuation",
         "Property": "property", "Tag": "tag", "Attribute": "attribute", "Heading": "heading", "Link": "link",
         "Url": "url", "Regex": "regex"}
  for k, v in syn.items():
    sp["syntax" + k] = c["syntax-" + v]
  langs = {"Java": ["Keyword", "Annotation", "String", "StringEscape", "Comment", "DocTag", "Number", "Constant",
                    "Function", "Class", "Type", "Variable", "Operator", "Punctuation", "Property"],
           "Python": ["Keyword", "String", "Comment", "Number", "Function", "Class", "Operator", "Punctuation",
                      "Property"],
           "Shell": ["Keyword", "String", "Comment", "Number", "Function", "Operator", "Punctuation"],
           "Js": ["Keyword", "String", "Regex", "Comment", "DocTag", "Number", "Constant", "Function", "Class", "Type",
                  "Property", "Operator", "Punctuation"],
           "Json": ["String", "Number", "Constant", "Punctuation"],
           "Css": ["Function", "Comment", "Number", "Punctuation"],
           "Xml": ["Comment"],
           "Markdown": ["Heading", "Link", "Url"]}
  for lang, keys in langs.items():
    for k in keys:
      sp[f"syntax{lang}{k}"] = sp["syntax" + k]
  extra = {"syntaxJavaModifier": "keyword", "syntaxJavaStaticFinal": "constant", "syntaxJavaThisSuper": "keyword",
           "syntaxJavaImportPackage": "type", "syntaxShellExternalCommand": "function",
           "syntaxShellVariable": "property",
           "syntaxShellCommandSubstitution": "string", "syntaxPythonDecorator": "annotation",
           "syntaxPythonBuiltin": "type", "syntaxPythonByteString": "string", "syntaxJsTemplateInterpolation": "escape",
           "syntaxJsDecorator": "annotation", "syntaxJsonKey": "property", "syntaxCssSelector": "tag",
           "syntaxCssPropertyName": "property", "syntaxCssPropertyValue": "variable",
           "syntaxCssAttributeName": "attribute",
           "syntaxCssHash": "constant", "syntaxCssImportant": "doc-tag", "syntaxCssPseudo": "annotation",
           "syntaxCssUrl": "string", "syntaxCssColon": "punctuation", "syntaxCssAtRule": "keyword",
           "syntaxCssCustomProperty": "property", "syntaxXmlTagName": "tag", "syntaxXmlTag": "punctuation",
           "syntaxXmlAttributeName": "attribute", "syntaxXmlAttributeValue": "string",
           "syntaxXmlEntityReference": "escape", "syntaxXmlCustomTagName": "type", "syntaxMarkdownCode": "string",
           "syntaxMarkdownListMarker": "keyword", "syntaxMarkdownQuote": "comment",
           "syntaxMarkdownFence": "punctuation", "syntaxMarkdownFenceLang": "annotation"}
  for k, v in extra.items():
    sp[k] = c["syntax-" + v]
  sp["syntaxMarkdownBold"] = c["text-bright"]
  sp["syntaxMarkdownItalic"] = c["text"]
  out = {"wallpaper": pal["meta"].get("wallpaper", ""), "alpha": "100", "special": sp, "colors": {f"color{i}": c[f"ansi-{i}"] for i in range(16)}}
  return json.dumps(out, indent=2) + "\n"


def fmt_pywal_sh(pal, theme):
  c = resolve(pal, theme)
  lines = ["# Generated by Themer (pywal compatible).", "wallpaper=''", f"background='{c['bg']}'",
           f"foreground='{c['text']}'", f"cursor='{c['text']}'"]
  lines += [f"color{i}='{c[f'ansi-{i}']}'" for i in range(16)]
  lines.append("export color0 color1 color2 color3 color4 color5 color6 color7 color8 color9 color10 color11 "
               "color12 color13 color14 color15 background foreground cursor")
  return "\n".join(lines) + "\n"


def fmt_pywal_css(pal, theme):
  c = resolve(pal, theme)
  lines = ["/* Generated by Themer (pywal compatible). */", ":root {", "  --wallpaper: url(\"\");",
           f"  --background: {c['bg']};", f"  --foreground: {c['text']};", f"  --cursor: {c['text']};"]
  lines += [f"  --color{i}: {c[f'ansi-{i}']};" for i in range(16)]
  return "\n".join(lines + ["}"]) + "\n"


def fmt_kvantum_svg(pal, theme):
  sys.path.insert(0, str(Path(__file__).resolve().parent))
  import kvantum
  ctx = context(pal, theme)
  colors = {k: v for k, v in ctx.items() if isinstance(v, str) and COLOR_RE.match(v)}
  numbers = {k.split(".", 1)[1]: v for k, v in ctx.items() if k.startswith(("shape.", "kvantum."))}
  return kvantum.build(colors, numbers)


