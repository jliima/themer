# Written by Themer: the Kvantum theme "Themer{{ dark-suffix }}" for {{ name }} {{ variant }}. The SVG next to it
# comes from themer/kvantum.py; both follow the applied theme's tokens.
[%General]
author=Themer
comment={{ name }} {{ variant }}, generated by Themer
respect_DE=true
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
center_normal_tabs=false
center_doc_tabs=false
joined_inactive_tabs=true
attach_active_tab=false
embedded_tabs=false
no_active_tab_separator=false
group_toolbar_buttons=false
toolbutton_style=0
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height={{ kvantum.menu-separator }}
submenu_overlap=0
scroll_width={{ kvantum.scroll-width }}
scroll_arrows=false
scroll_min_extent=36
scrollbar_in_view=true
transient_scrollbar=false
slider_width={{ kvantum.slider-width }}
slider_handle_width={{ kvantum.slider-handle }}
slider_handle_length={{ kvantum.slider-handle }}
tickless_slider_handle_size={{ kvantum.slider-handle }}
progressbar_thickness={{ kvantum.progress-thickness }}
spread_progressbar=true
check_size={{ kvantum.check-size }}
splitter_width=5
inline_spin_indicators=true
vertical_spin_indicators=true
spin_button_width=18
combo_as_lineedit=true
combo_menu=true
square_combo_button=false
animate_states=true
tree_branch_line=false
fill_rubberband=false
no_inactiveness=true
no_selection_tint=true
dark_titlebar={{ is-dark }}
layout_spacing=6
layout_margin=8
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
toolbar_item_spacing=2
toolbar_interior_spacing=2
toolbar_separator_thickness=1
tooltip_delay=600
submenu_delay=200
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
remove_extra_frames=true
dialog_button_layout=0
click_behavior=0
kinetic_scrolling=false
middle_click_scroll=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx

[GeneralColors]
window.color={{ bg }}
base.color={{ bg-sunken }}
alt.base.color={{ bg }}
button.color={{ surface-hover }}
light.color={{ surface-active }}
mid.light.color={{ surface-raised }}
dark.color={{ bg-deep }}
mid.color={{ line }}
shadow.color={{ bg-deep }}
highlight.color={{ kde-selection }}
inactive.highlight.color={{ kde-selection }}
tooltip.base.color={{ surface-raised }}
text.color={{ text }}
window.text.color={{ text }}
button.text.color={{ text }}
disabled.text.color={{ text-disabled }}
tooltip.text.color={{ text }}
highlight.text.color={{ kde-selection-text }}
link.color={{ link }}
link.visited.color={{ violet }}
progress.indicator.text.color={{ text }}

[Hacks]
respect_darkness=true
transparent_dolphin_view=false
force_size_grip=false
tint_on_mouseover=0
no_selection_tint=true
disabled_icon_opacity=60
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
single_top_toolbar=false
style_vertical_toolbars=false
middle_click_scroll=false
centered_forms=false
kcapacitybar_as_progressbar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top={{ shape.radius-sm }}
frame.bottom={{ shape.radius-sm }}
frame.left={{ shape.radius-sm }}
frame.right={{ shape.radius-sm }}
interior=true
interior.element=button
indicator.element=arrow
indicator.size={{ kvantum.arrow-size }}
min_height={{ kvantum.button-height }}
text.normal.color={{ text }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.shadow=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.iconspacing=6

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
min_height=0
text.normal.color={{ text-muted }}
text.margin.left=4
text.margin.right=4

[ToolboxTab]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock
text.normal.color={{ text-subtle }}
text.focus.color={{ text }}
text.bold=false
min_height=0

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size={{ kvantum.arrow-size }}

[RadioButton]
inherits=PanelButtonCommand
interior.element=radio
min_height=0
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=PanelButtonCommand
interior.element=checkbox
min_height=0
text.margin.left=4
text.margin.right=4

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.normal.color={{ text }}

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size={{ kvantum.arrow-size }}

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior=false
interior.element=tab
indicator.element=tab
frame.top=0
frame.bottom=3
frame.left=0
frame.right=0
min_height=0
text.normal.color={{ text-subtle }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.margin.top=6
text.margin.bottom=5
text.margin.left=12
text.margin.right=12

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=true
frame.element=tabbarframe
interior=false
frame.top=0
frame.bottom=1
frame.left=0
frame.right=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=tree
indicator.size={{ kvantum.arrow-size }}
min_height=0

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior=false
frame.top=0
frame.bottom=1
frame.left=0
frame.right=1
min_height=0
text.normal.color={{ text-subtle }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.bold=false
indicator.element=arrow
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
frame=false
interior=false
frame.element=toolbar
interior.element=toolbar
min_height=0
text.normal.color={{ text-muted }}

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
frame.element=menubar
interior.element=menubar
min_height=0

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top={{ shape.radius-sm }}
frame.bottom={{ shape.radius-sm }}
frame.left={{ shape.radius-sm }}
frame.right={{ shape.radius-sm }}
min_height=0
text.normal.color={{ text }}
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top={{ shape.radius-md }}
frame.bottom={{ shape.radius-md }}
frame.left={{ shape.radius-md }}
frame.right={{ shape.radius-md }}
min_height=0
text.normal.color={{ text }}

[MenuItem]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
# The frame holds the inset (menu-padding) and the rounded highlight (radius-sm).
frame.top={{ shape.radius-sm }}
frame.bottom={{ shape.radius-sm }}
frame.left={{ kvantum.menu-padding | add(shape.radius-sm) }}
frame.right={{ kvantum.menu-padding | add(shape.radius-sm) }}
min_height={{ kvantum.row-height }}
text.normal.color={{ text }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.margin.top=0
text.margin.bottom=0
text.margin.left=8
text.margin.right=8

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion={{ shape.radius-sm | int }}
min_height=0
text.normal.color={{ text }}
text.focus.color={{ text }}
text.press.color={{ kde-selection-text }}
text.toggle.color={{ kde-selection-text }}
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=splitter
frame.element=splitter
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false
interior.element=scrollgroove
frame.element=scrollgroove

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top={{ kvantum.scroll-width | div(2) }}
frame.bottom={{ kvantum.scroll-width | div(2) }}
frame.left={{ kvantum.scroll-width | div(2) }}
frame.right={{ kvantum.scroll-width | div(2) }}
interior=false
indicator.element=grip
indicator.size=0
min_height=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top={{ kvantum.slider-width | div(2) }}
frame.bottom={{ kvantum.slider-width | div(2) }}
frame.left={{ kvantum.slider-width | div(2) }}
frame.right={{ kvantum.slider-width | div(2) }}
interior=false
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top={{ kvantum.progress-thickness | div(2) }}
frame.bottom={{ kvantum.progress-thickness | div(2) }}
frame.left={{ kvantum.progress-thickness | div(2) }}
frame.right={{ kvantum.progress-thickness | div(2) }}
interior=false
min_height=0
text.normal.color={{ text-subtle }}
text.focus.color={{ text-subtle }}
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
interior=false
frame.top={{ kvantum.progress-thickness | div(2) }}
frame.bottom={{ kvantum.progress-thickness | div(2) }}
frame.left={{ kvantum.progress-thickness | div(2) }}
frame.right={{ kvantum.progress-thickness | div(2) }}

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size={{ kvantum.arrow-size }}
indicator.element=mdi
text.normal.color={{ titlebar-text }}
text.focus.color={{ titlebar-text }}
text.bold=false

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top={{ shape.radius-md }}
frame.bottom={{ shape.radius-md }}
frame.left={{ shape.radius-md }}
frame.right={{ shape.radius-md }}
text.shadow=false
text.margin=0
text.bold=true

[ToolTip]
inherits=GenericFrame
frame.top={{ shape.radius-sm }}
frame.bottom={{ shape.radius-sm }}
frame.left={{ shape.radius-sm }}
frame.right={{ shape.radius-sm }}
interior=true
text.shadow=false
text.margin=2
interior.element=tooltip
frame.element=tooltip
text.normal.color={{ text }}

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
