[General]
Description={{ name }} {{ Variant }}
Opacity=1
Blur=false
ColorRandomization=false
FillStyle=Tile
Wallpaper=
WallpaperOpacity=1

[Background]
Color={{ bg | rgb }}

[BackgroundFaint]
Color={{ bg | rgb }}

[BackgroundIntense]
Color={{ bg | rgb }}

[Foreground]
Color={{ text | rgb }}

[ForegroundFaint]
Color={{ text-subtle | rgb }}

[ForegroundIntense]
Color={{ text-bright | rgb }}

[Color0]
Color={{ ansi-0 | rgb }}

[Color0Faint]
Color={{ ansi-0 | mix(bg, 0.4) | rgb }}

[Color0Intense]
Color={{ ansi-8 | rgb }}

[Color1]
Color={{ ansi-1 | rgb }}

[Color1Faint]
Color={{ ansi-1 | mix(bg, 0.4) | rgb }}

[Color1Intense]
Color={{ ansi-9 | rgb }}

[Color2]
Color={{ ansi-2 | rgb }}

[Color2Faint]
Color={{ ansi-2 | mix(bg, 0.4) | rgb }}

[Color2Intense]
Color={{ ansi-10 | rgb }}

[Color3]
Color={{ ansi-3 | rgb }}

[Color3Faint]
Color={{ ansi-3 | mix(bg, 0.4) | rgb }}

[Color3Intense]
Color={{ ansi-11 | rgb }}

[Color4]
Color={{ ansi-4 | rgb }}

[Color4Faint]
Color={{ ansi-4 | mix(bg, 0.4) | rgb }}

[Color4Intense]
Color={{ ansi-12 | rgb }}

[Color5]
Color={{ ansi-5 | rgb }}

[Color5Faint]
Color={{ ansi-5 | mix(bg, 0.4) | rgb }}

[Color5Intense]
Color={{ ansi-13 | rgb }}

[Color6]
Color={{ ansi-6 | rgb }}

[Color6Faint]
Color={{ ansi-6 | mix(bg, 0.4) | rgb }}

[Color6Intense]
Color={{ ansi-14 | rgb }}

[Color7]
Color={{ ansi-7 | rgb }}

[Color7Faint]
Color={{ ansi-7 | mix(bg, 0.4) | rgb }}

[Color7Intense]
Color={{ ansi-15 | rgb }}
