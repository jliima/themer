{
  "metadata": {
    "name": "Themer {{ Variant }}",
    "revision": 1,
    "license": "SPDX-License-Identifier: MIT",
    "copyright": ["Generated by Themer from the {{ name }} theme"]
  },
  "text-styles": {
    "Normal": {"text-color": "{{ syntax-variable }}", "selected-text-color": "{{ syntax-variable }}", "bold": false, "italic": false, "underline": false, "strike-through": false},
    "Keyword": {"text-color": "{{ syntax-keyword }}", "selected-text-color": "{{ syntax-keyword }}", "bold": false},
    "ControlFlow": {"text-color": "{{ syntax-keyword }}", "selected-text-color": "{{ syntax-keyword }}", "bold": false},
    "Function": {"text-color": "{{ syntax-function }}", "selected-text-color": "{{ syntax-function }}"},
    "Variable": {"text-color": "{{ syntax-property }}", "selected-text-color": "{{ syntax-property }}"},
    "Operator": {"text-color": "{{ syntax-operator }}", "selected-text-color": "{{ syntax-operator }}"},
    "BuiltIn": {"text-color": "{{ syntax-type }}", "selected-text-color": "{{ syntax-type }}"},
    "Extension": {"text-color": "{{ syntax-class }}", "selected-text-color": "{{ syntax-class }}"},
    "Preprocessor": {"text-color": "{{ syntax-annotation }}", "selected-text-color": "{{ syntax-annotation }}"},
    "Attribute": {"text-color": "{{ syntax-annotation }}", "selected-text-color": "{{ syntax-annotation }}"},
    "Char": {"text-color": "{{ syntax-string }}", "selected-text-color": "{{ syntax-string }}"},
    "SpecialChar": {"text-color": "{{ syntax-escape }}", "selected-text-color": "{{ syntax-escape }}"},
    "String": {"text-color": "{{ syntax-string }}", "selected-text-color": "{{ syntax-string }}"},
    "VerbatimString": {"text-color": "{{ syntax-string }}", "selected-text-color": "{{ syntax-string }}"},
    "SpecialString": {"text-color": "{{ syntax-regex }}", "selected-text-color": "{{ syntax-regex }}"},
    "Import": {"text-color": "{{ syntax-type }}", "selected-text-color": "{{ syntax-type }}"},
    "DataType": {"text-color": "{{ syntax-type }}", "selected-text-color": "{{ syntax-type }}"},
    "DecVal": {"text-color": "{{ syntax-number }}", "selected-text-color": "{{ syntax-number }}"},
    "BaseN": {"text-color": "{{ syntax-number }}", "selected-text-color": "{{ syntax-number }}"},
    "Float": {"text-color": "{{ syntax-number }}", "selected-text-color": "{{ syntax-number }}"},
    "Constant": {"text-color": "{{ syntax-constant }}", "selected-text-color": "{{ syntax-constant }}"},
    "Comment": {"text-color": "{{ syntax-comment }}", "selected-text-color": "{{ syntax-comment }}", "italic": true},
    "Documentation": {"text-color": "{{ syntax-comment }}", "selected-text-color": "{{ syntax-comment }}", "italic": true},
    "Annotation": {"text-color": "{{ syntax-doc-tag }}", "selected-text-color": "{{ syntax-doc-tag }}", "italic": true},
    "CommentVar": {"text-color": "{{ syntax-doc-tag }}", "selected-text-color": "{{ syntax-doc-tag }}", "italic": true},
    "RegionMarker": {"text-color": "{{ syntax-link }}", "selected-text-color": "{{ syntax-link }}", "background-color": "{{ accent-soft }}"},
    "Information": {"text-color": "{{ info }}", "selected-text-color": "{{ info }}"},
    "Warning": {"text-color": "{{ warning }}", "selected-text-color": "{{ warning }}"},
    "Alert": {"text-color": "{{ danger }}", "selected-text-color": "{{ danger }}", "background-color": "{{ danger-soft }}", "bold": true},
    "Error": {"text-color": "{{ danger }}", "selected-text-color": "{{ danger }}", "underline": true},
    "Others": {"text-color": "{{ syntax-attribute }}", "selected-text-color": "{{ syntax-attribute }}"}
  },
  "editor-colors": {
    "BackgroundColor": "{{ bg }}",
    "CodeFolding": "{{ accent-soft }}",
    "BracketMatching": "{{ surface-active }}",
    "CurrentLine": "{{ bg | mix(surface, 0.6) }}",
    "IconBorder": "{{ bg }}",
    "IndentationLine": "{{ line }}",
    "LineNumbers": "{{ text-disabled }}",
    "CurrentLineNumber": "{{ text-muted }}",
    "MarkBookmark": "{{ blue }}",
    "MarkBreakpointActive": "{{ red }}",
    "MarkBreakpointReached": "{{ yellow }}",
    "MarkBreakpointDisabled": "{{ red-dim }}",
    "MarkExecution": "{{ green }}",
    "MarkWarning": "{{ orange }}",
    "MarkError": "{{ red }}",
    "ModifiedLines": "{{ orange }}",
    "ReplaceHighlight": "{{ green-soft }}",
    "SavedLines": "{{ green-dim }}",
    "SearchHighlight": "{{ yellow-soft }}",
    "TextSelection": "{{ selection }}",
    "Separator": "{{ line }}",
    "SpellChecking": "{{ red }}",
    "TabMarker": "{{ line }}",
    "TemplateBackground": "{{ surface }}",
    "TemplatePlaceholder": "{{ accent-soft }}",
    "TemplateFocusedPlaceholder": "{{ selection }}",
    "TemplateReadOnlyPlaceholder": "{{ surface-active }}",
    "WordWrapMarker": "{{ line }}"
  }
}
